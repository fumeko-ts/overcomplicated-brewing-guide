{
  "container_item": {
    "$base_id|default": "$brewing_guide:potion",
    "$potion_prefix|default": "",
    "$custom_slot_content|default": "common.empty_panel",
    "$item_collection|default": "$item_collection_name",
    "variables": [
      {
        "requires": "($item_collection_name = 'brewing_input_item')",
        "$custom_slot_content": "brewing_potion_slot.brewing_ingredient_item_slot"
      },
      {
        "requires": "($item_collection_name = 'brewing_result_items')",
        "$custom_slot_content": "brewing_potion_slot.brewing_result_item_slot"
      },
      {
        "requires": "($item_collection_name = 'brewing_fuel_item')",
        "$custom_slot_content": "brewing_potion_slot.fuel_input_slot"
      }
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {"slot_refrence@$custom_slot_content": {}}
        ]
      }
    ]
  }
}
