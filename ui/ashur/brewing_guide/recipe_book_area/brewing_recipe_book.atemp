{
  "namespace": "brewing_recipe_book",
  "recipe_book@global.empty_stack": {
    "orientation": "horizontal",
    "size": [183, 166],
    "controls": [
      {
        "tabs@global.empty_stack": {
          "orientation": "vertical",
          "size": [35, 166],
          "layer": 2,
          "$base_id|default": "$brewing_guide:potion",
          "controls": [
            { "filler_1@global.empty_panel": { "size": [35, 3] } },
            {
              "potion_tab_toggle@brewing_recipe_book.tab_template": {
                "$is_default_active": true,
                "$toggle_control_name": "potion_tab",
                "$toggle_group_forced_index": 0
              }
            },
            {
              "splash_potion_tab_toggle@brewing_recipe_book.tab_template": {
                "$toggle_control_name": "splash_potion_tab",
                "$base_id": "$brewing_guide:splash_potion",
                "$toggle_group_forced_index": 1
              }
            },
            {
              "lingering_potion_tab_toggle@brewing_recipe_book.tab_template": {
                "$toggle_control_name": "lingering_potion_tab",
                "$base_id": "$brewing_guide:lingering_potion",
                "$toggle_group_forced_index": 2
              }
            },
            { "filler_2@global.empty_panel": { "size": [35, "fill"] } }
          ]
        }
      },
      {
        "recipe_book_content@global.root_panel": {
          "size": [147, 166],
          "controls": [
            {
              "book_half@global.empty_image": {
                "texture": "sprites/recipe_book.png",
                "size": [147, 166],
                "layer": 1,
                "controls": [
                  {
                    "holder@global.empty_stack": {
                      "orientation": "vertical",
                      "anchor_to": "top_right",
                      "anchor_from": "top_right",
                      "size": [122, 28],
                      "controls": [
                        { "buffer_1@global.empty_panel": { "size": [122, 12] } },
                        {
                          "search_and_filter@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [122, 16],
                            "controls": [
                              {
                                "search_holder@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [81, 16],
                                  "controls": [
                                    { "buffer_1@global.empty_panel": { "size": [81, 1] } },
                                    {
                                      "text_edit_control@text_edit_area.text_edit_box": {
                                        "size": [81, 14],
                                        "$edit_label_offset": [2, 0],
                                        "$place_holder_text_offset": [3, 0],
                                        "layer": 4,
                                        "property_bag": {
                                          "#enabled": false
                                        },
                                        "$place_holder_text_color": [0.659, 0.659, 0.659],
                                        "$place_holder_text_shadow_color": [0.165, 0.165, 0.165],
                                        "$place_holder_text": "atemp.recipe_book.searchBox",
                                        "$default_control": "screen_content.text_field",
                                        "$locked_control": "screen_content.text_field",
                                        "$hover_control": "screen_content.text_field_highlighted",
                                        "$pressed_control": "screen_content.text_field_highlighted"
                                      }
                                    },
                                    { "buffer_2@global.empty_panel": { "size": [81, 1] } }
                                  ]
                                }
                              },
                              { "buffer_1@global.empty_panel": { "size": [4, 16] } },
                              {
                                "recipe_filter@crafting_common.filter_toggle": {
                                  "$locked": "brewing_recipe_book.filter_locked",
                                  "$toggle_enabled": false
                                }
                              },
                              { "buffer_2@global.empty_panel": { "size": [11, 16] } }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "recipe_grids_holder@global.empty_panel": {
                      "size": [125, 100],
                      "anchor_from": "top_right",
                      "anchor_to": "top_right",
                      "offset": [-11, 31],
                      "$base_id|default": "$brewing_guide:potion",
                      "$visible_condition|default": "potion_tab",
                      "$index_offset|default": 100,

                      "controls": [
                        { "potion@brewing_recipe_book_grid.recipe_book_grid": {} },
                        {
                          "splash_potion@brewing_recipe_book_grid.recipe_book_grid": {
                            "$base_id": "$brewing_guide:splash_potion",
                            "$visible_condition": "splash_potion_tab",
                            "$index_offset": 200
                          }
                        },
                        {
                          "lingering_potion@brewing_recipe_book_grid.recipe_book_grid": {
                            "$base_id": "$brewing_guide:lingering_potion",
                            "$visible_condition": "lingering_potion_tab",
                            "$index_offset": 300
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      { "spacer@global.empty_panel": { "size": [1, 166] } }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "brewing_guide_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ]
  },

  "tab_template@toggle.tab_toggle": {
    "size": [35, 27],
    "$is_left_tab": true,
    "$default_selected_index": 0,
    "$toggle_name": "navigation_tab",
    "$extra_contents": "brewing_recipe_book.center_item_icon",
    "$tab_texture_unchecked_offset": [5, 0],
    "$tab_texture_checked_offset": [3, 0],
    "$icon_unchecked_offset": [0, 0],
    "$icon_checked_offset": [-2, 0]
  },

  "center_item_icon@global.empty_panel": {
    "$remainder|default": 0,
    "controls": [
      {
        "single_tab_icons@brewing_global.item_renderer": {
          "offset": [14, 5],
          "layer": 7,
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      }
    ]
  },


  "filter_locked@screen_content.image_element": {
    "size": [26, 16],
    "texture": "sprites/filter_locked"
  }
}
