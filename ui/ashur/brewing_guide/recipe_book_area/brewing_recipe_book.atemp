{
  "namespace": "brewing_recipe_book",
  "recolourful_recipe_book@brewing_recipe_book.recipe_book": {
    "$brewing_filter_texture": "assets/brewing_guide/sprites/recipe_book/recolourful_filter_locked",
    "$brewing_overlay_texture": "assets/brewing_guide/sprites/recipe_book/crafting_overlay",
    "$brewing_recipe_book_texture": "assets/sprites/recipe_book",
    "$brewing_text_field_texture": "assets/sprites/recipe_book/text_field",
    "$brewing_slot_texture": "assets/sprites/recipe_book/slot_craftable",
    "$brewing_secondary_slot_texture": "assets/brewing_guide/sprites/recipe_book/slot_craftable",
    "$brewing_slot_checkmark_texture": "assets/brewing_guide/sprites/recipe_book/recolourful_slot_craftable_secondary_checked",
    "$unchecked_default_image": "assets/sprites/recipe_book/tab",
    "$unchecked_hover_image": "assets/sprites/recipe_book/tab",
    "$checked_default_image": "assets/sprites/recipe_book/tab_selected",
    "$checked_hover_image": "assets/sprites/recipe_book/tab_selected",
    "$search_text|default": " "
  },
  "recipe_book@brewing_global.empty_panel": {
    "size": ["100%c", "100%c"],
    "$brewing_recipe_book_texture|default": "assets/brewing_guide/recipe_book",
    "$brewing_text_field_texture|default": "assets/brewing_guide/sprites/recipe_book/text_field",
    "$brewing_filter_texture|default": "assets/brewing_guide/sprites/recipe_book/filter_locked",
    "$brewing_overlay_texture|default": "assets/brewing_guide/sprites/recipe_book/crafting_overlay",
    "$brewing_slot_texture|default": "assets/brewing_guide/sprites/recipe_book/slot_craftable",
    "$brewing_secondary_slot_texture|default": "assets/brewing_guide/sprites/recipe_book/slot_craftable",
    "$brewing_slot_checkmark_texture|default": "assets/brewing_guide/sprites/recipe_book/slot_craftable_secondary_checked",
    "$unchecked_default_image|default": "assets/brewing_guide/sprites/recipe_book/tab",
    "$unchecked_hover_image|default": "assets/brewing_guide/sprites/recipe_book/tab",
    "$checked_default_image|default": "assets/brewing_guide/sprites/recipe_book/tab_selected",
    "$checked_hover_image|default": "assets/brewing_guide/sprites/recipe_book/tab_selected",
    "$search_text|default": "§o%realmsSettingsScreen.searchBox",
    "controls": [
      {
        "recipe_book_content@brewing_global.empty_stack": {
          "orientation": "horizontal",
          "size": [183, 166],
          "controls": [
            {
              "tabs@brewing_global.empty_stack": {
                "orientation": "vertical",
                "size": [35, 166],
                "layer": 2,
                "$base_id|default": "$brewing_guide:potion",
                "controls": [
                  { "filler_1@brewing_global.empty_panel": { "size": [35, 3] } },
                  {
                    "potion_tab_toggle@brewing_recipe_book.tab_template": {
                      "$is_default_active": true,
                      "$toggle_control_name": "potion_tab",
                      "$toggle_group_forced_index": 0
                    }
                  },
                  {
                    "splash_potion_tab_toggle@brewing_recipe_book.tab_template": {
                      "$toggle_control_name": "splash_potion_tab",
                      "$base_id": "$brewing_guide:splash_potion",
                      "$toggle_group_forced_index": 1
                    }
                  },
                  {
                    "lingering_potion_tab_toggle@brewing_recipe_book.tab_template": {
                      "$toggle_control_name": "lingering_potion_tab",
                      "$base_id": "$brewing_guide:lingering_potion",
                      "$toggle_group_forced_index": 2
                    }
                  },
                  { "filler_2@brewing_global.empty_panel": { "size": [35, "fill"] } }
                ]
              }
            },
            {
              "recipe_book_content@brewing_global.root_panel": {
                "size": [147, 166],
                "controls": [
                  {
                    "book_half@brewing_global.empty_image": {
                      "texture": "$brewing_recipe_book_texture",
                      "size": [147, 166],
                      "layer": 1,
                      "$base_id|default": "$brewing_guide:potion",
                      "$visible_condition|default": "potion_tab",
                      "$index_offset|default": 100,
                      "controls": [
                        {
                          "holder@brewing_global.empty_stack": {
                            "orientation": "vertical",
                            "anchor_to": "top_right",
                            "anchor_from": "top_right",
                            "size": [122, 28],
                            "controls": [
                              { "buffer_1@brewing_global.empty_panel": { "size": [122, 12] } },
                              {
                                "search_and_filter@brewing_global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [122, 16],
                                  "controls": [
                                    {
                                      "search_holder@brewing_global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [81, 16],
                                        "controls": [
                                          { "buffer_1@brewing_global.empty_panel": { "size": [81, 1] } },
                                          { "search_box_placeholder_image@brewing_recipe_book.edit_box_image": {} },
                                          { "buffer_2@brewing_global.empty_panel": { "size": [81, 1] } }
                                        ]
                                      }
                                    },
                                    { "buffer_1@brewing_global.empty_panel": { "size": [4, 16] } },
                                    { "recipe_filter_placeholder_image@brewing_recipe_book.filter_locked": {} },
                                    { "buffer_2@brewing_global.empty_panel": { "size": [11, 16] } }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        { "potion@brewing_recipe_book_grid.recipe_book_grid": {} },
                        {
                          "splash_potion@brewing_recipe_book_grid.recipe_book_grid": {
                            "$base_id": "$brewing_guide:splash_potion",
                            "$visible_condition": "splash_potion_tab",
                            "$index_offset": 200
                          }
                        },
                        {
                          "lingering_potion@brewing_recipe_book_grid.recipe_book_grid": {
                            "$base_id": "$brewing_guide:lingering_potion",
                            "$visible_condition": "lingering_potion_tab",
                            "$index_offset": 300
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            { "spacer@brewing_global.empty_panel": { "size": [1, 166] } }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "brewing_guide_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "tab_template@brewing_toggle.tab_toggle": {
    "size": [35, 27],
    "$is_left_tab": true,
    "$default_selected_index": 0,
    "$toggle_name": "navigation_tab",
    "$extra_contents": "brewing_recipe_book.center_item_icon",
    "$tab_texture_unchecked_offset": [5, 0],
    "$tab_texture_checked_offset": [3, 0],
    "$icon_unchecked_offset": [0, 0],
    "$icon_checked_offset": [-2, 0]
  },

  "center_item_icon@brewing_global.empty_panel": {
    "$remainder|default": 0,
    "controls": [
      {
        "single_tab_icons@brewing_global.item_renderer": {
          "offset": [14, 5],
          "layer": 7,
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      }
    ]
  },

  "filter_locked@brewing_global.empty_image": {
    "size": [26, 16],
    "texture": "$brewing_filter_texture",
    "controls": [
      {
        "disabled_notif@brewing_global.custom_hover_text_renderer": {
          "$translation_keys": "options.dev_nethernet_logging_verbosity.disabled"
        }
      }
    ]
  },

  "edit_box_image@brewing_global.empty_image": {
    "texture": "$brewing_text_field_texture",
    "size": [81, 14],
    "nineslice_size": 3,
    "layer": 4,
    "controls": [
      {
        "disabled_notif@brewing_global.custom_hover_text_renderer": {
          "$translation_keys": "options.dev_nethernet_logging_verbosity.disabled"
        }
      },
      {
        "place_holder_text_label@brewing_global.empty_panel": {
          "size": ["100%", "100%"],
          "offset": [3, 0],
          "controls": [
            {
              "overlay@brewing_recipe_book.search_label_template": {
                "layer": 3,
                "color": [0.659, 0.659, 0.659]
              }
            },
            {
              "underlay@brewing_recipe_book.search_label_template": {
                "offset": [1, 1]
              }
            }
          ]
        }
      }
    ]
  },
  "recolourful_layout_toggle@compatibility_common.general_recipe_toggle": {
    "$recipe_book_open_control_name": "brewing_guide_toggle",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [16, 49]
  },

  "layout_toggle@brewing_toggle.recipe_layout_toggle": {
    "$recipe_book_open_control_name": "brewing_guide_toggle",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [16, 49]
  },

  "search_label_template@brewing_global.empty_label": {
    "size": ["default", 10],
    "text": "$search_text",
    "color": [0.165, 0.165, 0.165],
    "localize": true,
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "font_size": "normal",
    "text_alignment": "left"
  }
}
