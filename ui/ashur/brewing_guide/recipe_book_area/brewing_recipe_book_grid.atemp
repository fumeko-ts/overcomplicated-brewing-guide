{
  "namespace": "brewing_recipe_book_grid",
  "recipe_book_grid@brewing_global.text_keys": {
    "type": "grid",
    "grid_dimensions": [5, 4],
    "size": [125, 100],
    "controls": [
      { "potion_1@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [0, 0], "$collection_index": 1 , "$localization_keys": "$awkward_potion_key"    , "$remainder": "$brewing_guide:awkward_potion"  } },
      { "potion_2@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [1, 0], "$collection_index": 2 , "$localization_keys": "$night_vision_key"      , "$remainder": "$brewing_guide:potion_of_night_vision" } },
      { "potion_3@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [2, 0], "$collection_index": 3 , "$localization_keys": "$invisibility_key"      , "$remainder": "$brewing_guide:potion_of_invisibility" } },
      { "potion_4@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [3, 0], "$collection_index": 4 , "$localization_keys": "$leaping_key"           , "$remainder": "$brewing_guide:potion_of_leaping" } },
      { "potion_5@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [4, 0], "$collection_index": 5 , "$localization_keys": "$fire_resistance_key"   , "$remainder": "$brewing_guide:potion_of_fire_resistance" } },

      { "potion_6@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [0, 1], "$collection_index": 6 , "$localization_keys": "$swiftness_key"         , "$remainder": "$brewing_guide:potion_of_swiftness" } },
      { "potion_7@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [1, 1], "$collection_index": 7 , "$localization_keys": "$slowness_key"          , "$remainder": "$brewing_guide:potion_of_slowness" } },
      { "potion_8@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [2, 1], "$collection_index": 8 , "$localization_keys": "$water_breathing_key"   , "$remainder": "$brewing_guide:potion_of_water_breathing" } },
      { "potion_9@brewing_recipe_book_grid.recipe_grid_item" : { "grid_position": [3, 1], "$collection_index": 9 , "$localization_keys": "$healing_key"           , "$remainder": "$brewing_guide:potion_of_healing" } },
      { "potion_10@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [4, 1], "$collection_index": 10, "$localization_keys": "$harming_key"           , "$remainder": "$brewing_guide:potion_of_harming" } },

      { "potion_11@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [0, 2], "$collection_index": 11, "$localization_keys": "$poison_key"            , "$remainder": "$brewing_guide:potion_of_poison" } },
      { "potion_12@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [1, 2], "$collection_index": 12, "$localization_keys": "$regeneration_key"      , "$remainder": "$brewing_guide:potion_of_regeneration" } },
      { "potion_13@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [2, 2], "$collection_index": 13, "$localization_keys": "$strength_key"          , "$remainder": "$brewing_guide:potion_of_strength" } },
      { "potion_14@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [3, 2], "$collection_index": 14, "$localization_keys": "$weakness_key"          , "$remainder": "$brewing_guide:potion_of_weakness" } },
      { "potion_15@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [4, 2], "$collection_index": 15, "$localization_keys": "$the_turtle_master_key" , "$remainder": "$brewing_guide:potion_of_the_turtle_master" } },

      { "potion_16@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [0, 3], "$collection_index": 16, "$localization_keys": "$slow_falling_key"      , "$remainder": "$brewing_guide:potion_of_slow_falling" } },
      { "potion_17@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [1, 3], "$collection_index": 17, "$localization_keys": "$wind_charging_key"     , "$remainder": "$brewing_guide:potion_of_wind_charging" } },
      { "potion_18@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [2, 3], "$collection_index": 18, "$localization_keys": "$weaving_key"           , "$remainder": "$brewing_guide:potion_of_weaving" } },
      { "potion_19@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [3, 3], "$collection_index": 19, "$localization_keys": "$oozing_key"            , "$remainder": "$brewing_guide:potion_of_oozing" } },
      { "potion_20@brewing_recipe_book_grid.recipe_grid_item": { "grid_position": [4, 3], "$collection_index": 20, "$localization_keys": "$infestation_key"       , "$remainder": "$brewing_guide:potion_of_infestation" } }
    ],

    "collection_name": "brewing_recipe_items",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$visible_condition",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "item_toggle@toggle.radio_toggle": {
    "$item_index_id|default": "($collection_index + $index_offset)"
  },
  "recipe_grid_item@brewing_recipe_book_grid.item_toggle": {
    "size": [25, 25],
    "$toggle_group_forced_index": "$item_index_id",
    "$toggle_name": "brewing_items",

    "$toggle_control_name": "('potion_item_' + $item_index_id)",
    "$toggle_binding_value": "('#item_' + $item_index_id)",

    "$localization_key|default": "",
    "$controls": [
      {
        "renderer_holder@global.empty_panel": {
          "size": [24, 24],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "renderer@brewing_global.item_renderer": {
                "layer": 4
              }
            }
          ]
        }
      },
      {
        "recipe_button_bg@screen_content.image_element": {
          "texture": "sprites/slot_craftable",
          "layer": 2,
          "size": [25, 25]
        }
      },
      {
        "hover_text_area@brewing_global.custom_hover_text_renderer": {}
      }
    ]
  }
}
