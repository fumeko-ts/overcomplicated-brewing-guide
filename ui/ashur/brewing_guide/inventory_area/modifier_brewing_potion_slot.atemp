{
  "namespace": "modifier_brewing_potion_slot",

  //potion duration
  "duration_potion_factory@brewing_potion_slot.splash_potion_factory": {
    "$factory_name": "duration_potion_factory",
    "$factory_binding_refrence": "factory_bindings.duration_potion_bindings",
    "$base_id": "$brewing_guide:potion"
  },

  "duration_ingredient_potion_factory@brewing_potion_slot.slot_factory_template": {
