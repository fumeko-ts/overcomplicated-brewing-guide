  "lingering_potion_factory@brewing_potion_slot.splash_potion_factory": {
    "$factory_name": "lingering_potion_slot_factory",
    "$factory_binding_refrence": "factory_bindings.lingering_potion_bindings",
    "$base_id": "$brewing_guide:splash_potion"
  },

  //potion slot items
  "water_bottle@brewing_global.container_item_slot_overlay":            {                                                               "$potion_key_type": "is_water_bottle_key"   },
  "awkward_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:awkward_potion"              , "$potion_key_type": "is_awkward_potion_key"  },
  "night_vision_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_night_vision"      , "$potion_key_type": "is_night_vision_key"    },
  "invisibility_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_invisibility"      , "$potion_key_type": "is_invisibility_key"    },
  "leaping_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_leaping"           , "$potion_key_type": "is_leaping_key"         },
  "fire_resistance_potion@brewing_global.container_item_slot_overlay" : { "$remainder" : "$brewing_guide:potion_of_fire_resistance"   , "$potion_key_type": "is_fire_resistance_key" },
  "swiftness_potion@brewing_global.container_item_slot_overlay"       : { "$remainder" : "$brewing_guide:potion_of_swiftness"         , "$potion_key_type": "is_swiftness_key"       },
  "slowness_potion@brewing_global.container_item_slot_overlay"        : { "$remainder" : "$brewing_guide:potion_of_slowness"          , "$potion_key_type": "is_slowness_key"        },
  "water_breathing_potion@brewing_global.container_item_slot_overlay" : { "$remainder" : "$brewing_guide:potion_of_water_breathing"   , "$potion_key_type": "is_water_breathing_key" },
  "healing_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_healing"           , "$potion_key_type": "is_healing_key"         },
  "harming_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_harming"           , "$potion_key_type": "is_harming_key"         },
  "poison_potion@brewing_global.container_item_slot_overlay"          : { "$remainder" : "$brewing_guide:potion_of_poison"            , "$potion_key_type": "is_poison_key"          },
  "regeneration_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_regeneration"      , "$potion_key_type": "is_regeneration_key"    },
  "strength_potion@brewing_global.container_item_slot_overlay"        : { "$remainder" : "$brewing_guide:potion_of_strength"          , "$potion_key_type": "is_strength_key"        },
  "weakness_potion@brewing_global.container_item_slot_overlay"        : { "$remainder" : "$brewing_guide:potion_of_weakness"          , "$potion_key_type": "is_weakness_key"        },
  "turtle_master_potion@brewing_global.container_item_slot_overlay"   : { "$remainder" : "$brewing_guide:potion_of_the_turtle_master" , "$potion_key_type": "is_turtle_master_key"   },
  "slow_falling_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_slow_falling"      , "$potion_key_type": "is_slow_falling_key"    },
  "wind_charging_potion@brewing_global.container_item_slot_overlay"   : { "$remainder" : "$brewing_guide:potion_of_wind_charging"     , "$potion_key_type": "is_wind_charging_key"   },
  "weaving_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_weaving"           , "$potion_key_type": "is_weaving_key"         },
  "oozing_potion@brewing_global.container_item_slot_overlay"          : { "$remainder" : "$brewing_guide:potion_of_oozing"            , "$potion_key_type": "is_oozing_key"          },
  "infestation_potion@brewing_global.container_item_slot_overlay"     : { "$remainder" : "$brewing_guide:potion_of_infestation"       , "$potion_key_type": "is_infested_key"     },

  //non potion items  
  "awkward_ingredients@brewing_global.container_item_slot_overlay"         : {"$base_id": "$brewing_guide:nether_wart",          "$potion_key_type": "is_nether_wart_key"          },
  "night_vision_ingredients@brewing_global.container_item_slot_overlay"    : {"$base_id": "$brewing_guide:golden_carrot",        "$potion_key_type": "is_golden_carrot_key"        },
  "invisibility_ingredients@brewing_global.container_item_slot_overlay"    : {"$base_id": "$brewing_guide:fermented_spider_eye", "$potion_key_type": "is_fermented_spider_eye_key" },
  "leaping_ingredients@brewing_global.container_item_slot_overlay"         : {"$base_id": "$brewing_guide:rabbit_foot",          "$potion_key_type": "is_rabbit_foot_key"          },
  "fire_resistance_ingredients@brewing_global.container_item_slot_overlay" : {"$base_id": "$brewing_guide:magma_cream",          "$potion_key_type": "is_magma_cream_key"          },
  "swiftness_ingredients@brewing_global.container_item_slot_overlay"       : {"$base_id": "$brewing_guide:sugar",                "$potion_key_type": "is_sugar_key"                },
  "slowness_ingredients@brewing_global.container_item_slot_overlay"        : {"$base_id": "$brewing_guide:fermented_spider_eye", "$potion_key_type": "is_fermented_spider_eye_key" },
  "water_breathing_ingredients@brewing_global.container_item_slot_overlay" : {"$base_id": "$brewing_guide:pufferfish",           "$potion_key_type": "is_pufferfish_key"           },
  "healing_ingredients@brewing_global.container_item_slot_overlay"         : {"$base_id": "$brewing_guide:glistering_melon",     "$potion_key_type": "is_glistering_melon_key"     },
  "harming_ingredients@brewing_global.container_item_slot_overlay"         : {"$base_id": "$brewing_guide:fermented_spider_eye", "$potion_key_type": "is_fermented_spider_eye_key" },
  "poison_ingredients@brewing_global.container_item_slot_overlay"          : {"$base_id": "$brewing_guide:spider_eye",           "$potion_key_type": "is_spider_eye_key"           },
  "regeneration_ingredients@brewing_global.container_item_slot_overlay"    : {"$base_id": "$brewing_guide:ghast_tear",           "$potion_key_type": "is_ghast_tear_key"           },
  "strength_ingredients@brewing_global.container_item_slot_overlay"        : {"$base_id": "$brewing_guide:blaze_powder",         "$potion_key_type": "is_blaze_powder_key"         },
  "weakness_ingredients@brewing_global.container_item_slot_overlay"        : {"$base_id": "$brewing_guide:fermented_spider_eye", "$potion_key_type": "is_fermented_spider_eye_key" },
  "turtle_master_ingredients@brewing_global.container_item_slot_overlay"   : {"$base_id": "$brewing_guide:turtle_shell",         "$potion_key_type": "is_turtle_shell_key"         },
  "slow_falling_ingredients@brewing_global.container_item_slot_overlay"    : {"$base_id": "$brewing_guide:phantom_membrane",     "$potion_key_type": "is_phantom_membrane_key"     },
  "wind_charging_ingredients@brewing_global.container_item_slot_overlay"   : {"$base_id": "$brewing_guide:breeze_rod",           "$potion_key_type": "is_breeze_rod_key"           },
  "weaving_ingredients@brewing_global.container_item_slot_overlay"         : {"$base_id": "$brewing_guide:cobweb",               "$potion_key_type": "is_cobweb_key"               },
  "oozing_ingredients@brewing_global.container_item_slot_overlay"          : {"$base_id": "$brewing_guide:slime_block",          "$potion_key_type": "is_slime_block_key"          },
  "infestation_ingredients@brewing_global.container_item_slot_overlay"     : {"$base_id": "$brewing_guide:stone",                "$potion_key_type": "is_stone_key"                },
 
