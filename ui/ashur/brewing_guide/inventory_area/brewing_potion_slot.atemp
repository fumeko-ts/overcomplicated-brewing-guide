{
  "namespace": "brewing_potion_slot",
  "slot_factory_template@brewing_global.factory": {
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "$item_collection",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux = -1)",
        "target_property_name": "#visible"
      }
    ]
  },
  //ingredient slot overlay  
  "potion_ingredient_factory@brewing_potion_slot.slot_factory_template": {
    "$factory_name": "potion_ingredient_slot_factory",
    "$factory_binding_refrence": "factory_bindings.potion_bindings",

    "$awkward_potion_action": "brewing_potion_slot.awkward_ingredients",
    "$night_vision_action": "brewing_potion_slot.night_vision_ingredients",
    "$invisibility_action": "brewing_potion_slot.invisibility_ingredients",
    "$leaping_action": "brewing_potion_slot.leaping_ingredients",
    "$fire_resistance_action": "brewing_potion_slot.fire_resistance_ingredients",
    "$swiftness_action": "brewing_potion_slot.swiftness_ingredients",
    "$slowness_action": "brewing_potion_slot.slowness_ingredients",
    "$water_breathing_action": "brewing_potion_slot.water_breathing_ingredients",
    "$healing_action": "brewing_potion_slot.healing_ingredients",
    "$harming_action": "brewing_potion_slot.harming_ingredients",
    "$poison_action": "brewing_potion_slot.poison_ingredients",
    "$regeneration_action": "brewing_potion_slot.regeneration_ingredients",
    "$strength_action": "brewing_potion_slot.strength_ingredients",
    "$weakness_action": "brewing_potion_slot.weakness_ingredients",
    "$turtle_master_action": "brewing_potion_slot.turtle_master_ingredients",
    "$slow_falling_action": "brewing_potion_slot.slow_falling_ingredients",
    "$wind_charging_action": "brewing_potion_slot.wind_charging_ingredients",
    "$weaving_action": "brewing_potion_slot.weaving_ingredients",
    "$oozing_action": "brewing_potion_slot.oozing_ingredients",
    "$infestation_action": "brewing_potion_slot.infestation_ingredients"
  }, 
  "splash_potion_ingredient_factory@brewing_potion_slot.slot_factory_template": {
    "$factory_name": "splash_potion_ingredient_slot_factory",
    "$factory_binding_refrence": "factory_bindings.splash_potion_bindings",

    "$awkward_potion_action": "brewing_potion_slot.gunpowder_ingredient",
