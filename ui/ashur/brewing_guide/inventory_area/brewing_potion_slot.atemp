  //potion slot overlay  
  "potion_factory@brewing_potion_slot.slot_factory_template": {
    "$factory_name": "potion_slot_factory",
    "$factory_binding_refrence": "factory_bindings.potion_bindings",

    "$base_id": "$brewing_guide:potion",
    "$awkward_potion_action": "brewing_potion_slot.water_bottle",
    "$night_vision_action": "brewing_potion_slot.awkward_potion",
    "$invisibility_action": "brewing_potion_slot.night_vision_potion",
