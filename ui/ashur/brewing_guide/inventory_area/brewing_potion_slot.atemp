  //potion slot items
  "water_bottle@brewing_global.container_item_slot_overlay":            {                                                               "$localization_keys": "water_bottle_key"   },
  "awkward_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:awkward_potion"              , "$localization_keys": "awkward_potion_key"  },
  "night_vision_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_night_vision"      , "$localization_keys": "night_vision_key"    },
  "invisibility_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_invisibility"      , "$localization_keys": "invisibility_key"    },
  "leaping_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_leaping"           , "$localization_keys": "leaping_key"         },
  "fire_resistance_potion@brewing_global.container_item_slot_overlay" : { "$remainder" : "$brewing_guide:potion_of_fire_resistance"   , "$localization_keys": "fire_resistance_key" },
  "swiftness_potion@brewing_global.container_item_slot_overlay"       : { "$remainder" : "$brewing_guide:potion_of_swiftness"         , "$localization_keys": "swiftness_key"       },
  "slowness_potion@brewing_global.container_item_slot_overlay"        : { "$remainder" : "$brewing_guide:potion_of_slowness"          , "$localization_keys": "slowness_key"        },
  "water_breathing_potion@brewing_global.container_item_slot_overlay" : { "$remainder" : "$brewing_guide:potion_of_water_breathing"   , "$localization_keys": "water_breathing_key" },
  "healing_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_healing"           , "$localization_keys": "healing_key"         },
  "harming_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_harming"           , "$localization_keys": "harming_key"         },
  "poison_potion@brewing_global.container_item_slot_overlay"          : { "$remainder" : "$brewing_guide:potion_of_poison"            , "$localization_keys": "poison_key"          },
  "regeneration_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_regeneration"      , "$localization_keys": "regeneration_key"    },
  "strength_potion@brewing_global.container_item_slot_overlay"        : { "$remainder" : "$brewing_guide:potion_of_strength"          , "$localization_keys": "strength_key"        },
  "weakness_potion@brewing_global.container_item_slot_overlay"        : { "$remainder" : "$brewing_guide:potion_of_weakness"          , "$localization_keys": "weakness_key"        },
  "turtle_master_potion@brewing_global.container_item_slot_overlay"   : { "$remainder" : "$brewing_guide:potion_of_the_turtle_master" , "$localization_keys": "turtle_master_key"   },
  "slow_falling_potion@brewing_global.container_item_slot_overlay"    : { "$remainder" : "$brewing_guide:potion_of_slow_falling"      , "$localization_keys": "slow_falling_key"    },
  "wind_charging_potion@brewing_global.container_item_slot_overlay"   : { "$remainder" : "$brewing_guide:potion_of_wind_charging"     , "$localization_keys": "wind_charging_key"   },
  "weaving_potion@brewing_global.container_item_slot_overlay"         : { "$remainder" : "$brewing_guide:potion_of_weaving"           , "$localization_keys": "weaving_key"         },
  "oozing_potion@brewing_global.container_item_slot_overlay"          : { "$remainder" : "$brewing_guide:potion_of_oozing"            , "$localization_keys": "oozing_key"          },
  "infestation_potion@brewing_global.container_item_slot_overlay"     : { "$remainder" : "$brewing_guide:potion_of_infestation"       , "$localization_keys": "infestation_key"     },

  //non potion items  
  "awkward_ingredients@brewing_global.container_item_slot_overlay"         : {"$base_id": "$brewing_guide:nether_wart",          "$localization_keys": "nether_wart_key"          },
  "night_vision_ingredients@brewing_global.container_item_slot_overlay"    : {"$base_id": "$brewing_guide:golden_carrot",        "$localization_keys": "golden_carrot_key"        },
