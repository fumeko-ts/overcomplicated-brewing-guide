{
  "namespace": "brewing_potion_slot",
  "slot_factory_template@brewing_global.factory": {
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "$item_collection",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux = -1)",
        "target_property_name": "#visible"
      }
    ] 
  },

  "brewing_result_item_slot": {
    "type": "panel",
    "controls": [
      { "1@brewing_potion_slot.potion_factory": {} },
      { "2@brewing_potion_slot.splash_potion_factory": {} },
      { "3@brewing_potion_slot.lingering_potion_factory": {} },

      { "4@modifier_brewing_potion_slot.duration_potion_factory": {} },
      { "5@modifier_brewing_potion_slot.potency_potion_factory": {} },

      { "6@modifier_brewing_potion_slot.duration_splash_potion_factory": {} },
      { "7@modifier_brewing_potion_slot.potency_splash_potion_factory": {} },

      { "8@modifier_brewing_potion_slot.duration_lingering_potion_factory": {} },
      { "9@modifier_brewing_potion_slot.potency_lingering_potion_factory": {} }
    ]
  },

  "brewing_ingredient_item_slot": {
    "type": "panel",
    "controls": [
      { "1@brewing_potion_slot.potion_ingredient_factory": {} },
      { "2@brewing_potion_slot.splash_potion_ingredient_factory": {} },
      { "3@brewing_potion_slot.lingering_potion_ingredient_factory": {} },

      { "4@modifier_brewing_potion_slot.duration_ingredient_potion_factory": {} },
      { "5@modifier_brewing_potion_slot.potency_ingredient_potion_factory": {} },

      { "6@modifier_brewing_potion_slot.duration_ingredient_splash_potion_factory": {} },
      { "7@modifier_brewing_potion_slot.potency_ingredient_splash_potion_factory": {} },

      { "8@modifier_brewing_potion_slot.duration_ingredient_lingering_potion_factory": {} },
      { "9@modifier_brewing_potion_slot.potency_ingredient_lingering_potion_factory": {} }
    ]
  },
  "fuel_input_slot@brewing_global.text_keys": {
    "$remainder|default": 0,
    "controls": [
      {
        "fuel_slot@brewing_potion_slot.strength_ingredients": {
          "bindings": [
            {"binding_type":"view","source_control_name":"potion_slot_factory","source_property_name":"#item_selected_index","target_property_name":"#p1"},
            {"binding_type":"view","source_control_name":"splash_potion_slot_factory","source_property_name":"#item_selected_index","target_property_name":"#p2"},
            
            {"binding_type":"view","source_control_name":"lingering_potion_slot_factory","source_property_name":"#item_selected_index","target_property_name":"#p3"},
            {"binding_type":"view","source_control_name":"potion_ingredient_slot_factory","source_property_name":"#item_selected_index","target_property_name":"#p4"},

            {"binding_type":"view","source_control_name":"splash_potion_ingredient_slot_factory","source_property_name":"#item_selected_index","target_property_name":"#p5"},
            {"binding_type":"view","source_control_name":"lingering_potion_ingredient_slot_factory","source_property_name":"#item_selected_index","target_property_name":"#p6"},

            {"binding_type":"view","source_control_name":"duration_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p7"},
            {"binding_type":"view","source_control_name":"potency_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p8"},

            {"binding_type":"view","source_control_name":"duration_splash_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p9"},
            {"binding_type":"view","source_control_name":"potency_splash_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p10"},

            {"binding_type":"view","source_control_name":"duration_lingering_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p11"},
            {"binding_type":"view","source_control_name":"potency_lingering_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p12"},

            {"binding_type":"view","source_control_name":"duration_ingredient_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p13"},
            {"binding_type":"view","source_control_name":"potency_ingredient_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p14"},

            {"binding_type":"view","source_control_name":"duration_ingredient_splash_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p15"},
            {"binding_type":"view","source_control_name":"potency_ingredient_splash_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p16"},

            {"binding_type":"view","source_control_name":"duration_ingredient_lingering_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p17"},
            {"binding_type":"view","source_control_name":"potency_ingredient_lingering_potion_factory","source_property_name":"#item_selected_index","target_property_name":"#p18"},

            {"binding_name": "#brewing_fuel_ratio","binding_condition": "always"},
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "((((#p1 + #p2 + #p3 + #p4 + #p5 + #p6 + #p7 + #p8 + #p9 + #p10 + #p11 + #p12 + #p13 + #p14 + #p15 + #p16 + #p17 + #p18) * 1) > 0) and (#brewing_fuel_ratio = 1))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  //ingredient slot overlay  
  "potion_ingredient_factory@brewing_potion_slot.slot_factory_template": {
    "$factory_name": "potion_ingredient_slot_factory",
    "$factory_binding_refrence": "factory_bindings.potion_bindings",

    "$awkward_potion_action": "brewing_potion_slot.awkward_ingredients",
