  "custom_hover_text_renderer": {
    "type": "button",
    "hover_control": "custom_tooltip",
    "consume_event": false,
    "layer": 18,
    "consume_hover_events": false,
    /*
      to translate multiple keys in 1 label use % to concat them like '%somekey %someotherkey'  
      the % denotes a new translateable point (the space is not required but its best to have it)
      with this you can translate text and add custom text with bindings in the same label
    */
    "controls": [
      {
        "follow": {
          "type": "input_panel",
          /*
            since this element is not stuck in the visible state it is always visible meaning the tooltip dosent jump around on rehover
          */
          "follows_cursor": true,
          "consume_hover_events": false,
          "always_listen_to_input": false,
          "always_handle_pointer": true,
          "focus_enabled": false,
          "focus_magnet_enabled": false,
          "prevent_touch_input": true,
          "button_mappings": [],
          "controls": [
            {
              "custom_tooltip@global.empty_image": {
                "texture": "textures/ui/purpleBorder",
                "size": ["100%c + 10px", "100%c + 8px"],
                "nineslice_size": 3,
                "offset": [21, 0],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 200,
                "allow_clipping": false,
                "controls": [
                  {
                    "hover_text_label": {
                      "type": "label",
                      "text": "$localization_keys",
                      "shadow": false,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": ["default", "default"],
                      "layer": 2
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
