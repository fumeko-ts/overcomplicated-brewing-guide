        "$strength_key|default": "%potion.damageBoost.splash.name\n§7%potion.damageBoost (1:30)\n\n§5%potion.effects.whenDrank\n§9+3 %potion.damageBoost",
        "$weakness_key|default": "%potion.weakness.splash.name",
        "$the_turtle_master_key|default": "%potion.turtleMaster.splash.name\n§c%potion.turtleMaster (0:20)\n§7%potion.turtleMaster2 (0:20)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$slow_falling_key|default": "%potion.slowFalling.splash.name",
