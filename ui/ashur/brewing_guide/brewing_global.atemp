{
  "namespace": "brewing_global",
  "item_renderer@brewing_global.custom_renderer": {
    "$type": "inventory_item_renderer",
    "size": [16, 16],
    "anchor_from": "center",
    "anchor_to": "center",
    "property_bag": {
      "#item_id_aux": "(($base_id * 65536) + $remainder)"
    }
  },
  "item_slot_variables": {
    "always_listen_to_input": true,
    "consume_hover_events": false,
    "controls": [
      {
        "white_overlay@brewing_global.empty_image": {
          "size": [18, 18],
          "nineslice_size": 2,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png",
          "layer": 12,
          "alpha": 0.1915
        }
      },
      {
        "uncraftable_slot@brewing_global.empty_image": {
          "size": [18, 18],
          "nineslice_size": 2,
          "color": [0.996, 0.0, 0.008],
          "alpha": 0.19,
          "layer": 5,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png"
        }
      },
      {
        "hover_text_element@brewing_global.custom_hover_text_renderer": {
          "variables": {
            "requires": "$touch",
            "$tooltip_offset": [-20, 0],
            "$tooltip_anchor": "top_right"
          },
          "size": [18, 18]
        }
      },
      {"renderer@brewing_global.item_renderer":{"layer": 6}}
    ]
  },

  "container_item_slot_overlay@brewing_toggle.toggle": {
    "size": [18, 18],
    "$toggle_starts_active": true,
    "$toggle_click_sound_volume": 0,
    "$toggle_forced_index": -1,
    "$toggle_collection_name": "brewing_items",
    "$toggle_control_name": "brewing_reset",
    "$toggle_binding_value": "#item_brewing_reset",
    "$toggle_extra_properties": "brewing_global.item_slot_variables",
    "variables": {
      "requires": "$touch",
      "$toggle_mapping_type": "double_pressed"
    }
  },

  // factory is done like this to make it so i can re-use it without redeclairing, a new factory
  "factory@brewing_global.text_keys": {
    "size": [18, 18],

    "$remainder|default": 0,
    "$base_id|default": 0,

    "$potion_prefix|default": "",
    "$factory_name|default": "Minecraft", // set collection name so i can use #collection_index on the elements that use this with the same collection name(it can be almost eanything even !!LEMON!!)

    "$awkward_potion_action|default": "",
    "$night_vision_action|default": "",
    "$invisibility_action|default": "",
    "$leaping_action|default": "",
    "$fire_resistance_action|default": "",
    "$swiftness_action|default": "",
    "$slowness_action|default": "",
    "$water_breathing_action|default": "",
    "$healing_action|default": "",
    "$harming_action|default": "",
    "$poison_action|default": "",
    "$regeneration_action|default": "",
    "$strength_action|default": "",
    "$weakness_action|default": "",
    "$turtle_master_action|default": "",
    "$slow_falling_action|default": "",
    "$wind_charging_action|default": "",
    "$weaving_action|default": "",
    "$oozing_action|default": "",
    "$infestation_action|default": "",

    "$factory_control_identifiers|default": {
      "is_awkward_potion": "$awkward_potion_action",
      "is_night_vision": "$night_vision_action",
      "is_invisibility": "$invisibility_action",
      "is_leaping": "$leaping_action",
      "is_fire_resistance": "$fire_resistance_action",
      "is_swiftness": "$swiftness_action",
      "is_slowness": "$slowness_action",
      "is_water_breathing": "$water_breathing_action",
      "is_healing": "$healing_action",
      "is_harming": "$harming_action",
      "is_poison": "$poison_action",
      "is_regeneration": "$regeneration_action",
      "is_strength": "$strength_action",
      "is_weakness": "$weakness_action",
      "is_turtle_master": "$turtle_master_action",
      "is_slow_falling": "$slow_falling_action",
      "is_wind_charging": "$wind_charging_action",
      "is_weaving": "$weaving_action",
      "is_oozing": "$oozing_action",
      "is_infestation": "$infestation_action"
    },

    "$factory_binding_values|default": {
      "#item_index_1": ["is_awkward_potion"],
      "#item_index_2": ["is_night_vision"],
      "#item_index_3": ["is_invisibility"],
      "#item_index_4": ["is_leaping"],
      "#item_index_5": ["is_fire_resistance"],
      "#item_index_6": ["is_swiftness"],
      "#item_index_7": ["is_slowness"],
      "#item_index_8": ["is_water_breathing"],
      "#item_index_9": ["is_healing"],
      "#item_index_10": ["is_harming"],
      "#item_index_11": ["is_poison"],
      "#item_index_12": ["is_regeneration"],
      "#item_index_13": ["is_strength"],
      "#item_index_14": ["is_weakness"],
      "#item_index_15": ["is_turtle_master"],
      "#item_index_16": ["is_slow_falling"],
      "#item_index_17": ["is_wind_charging"],
      "#item_index_18": ["is_weaving"],
      "#item_index_19": ["is_oozing"],
      "#item_index_20": ["is_infestation"]
    },
    "$factory_binding_refrence|default": "factory_bindings.bindings", // used to customise whats input for the #collection_length (collection length accepts a array like this ["control_id_you_want_to_render"])

    "$brewing_factory_variables|default": [
      // passes static values from above to the the generated controls and inner parts
      "$awkward_potion_action",
      "$night_vision_action",
      "$invisibility_action",
      "$leaping_action",
      "$fire_resistance_action",
      "$swiftness_action",
      "$slowness_action",
      "$water_breathing_action",
      "$healing_action",
      "$harming_action",
      "$poison_action",
      "$regeneration_action",
      "$strength_action",
      "$weakness_action",
      "$turtle_master_action",
      "$slow_falling_action",
      "$wind_charging_action",
      "$weaving_action",
      "$oozing_action",
      "$infestation_action",
      "$base_id",
      "$remainder",
      "$item_collection",

      "$potion_prefix"
    ],

    "controls": [
      {
        "$factory_name@$factory_binding_refrence": {
          "type": "collection_panel",
          "size": [18, 18],
          "collection_name": "$factory_name", // same as the factory name for simplicity
          "factory": {
            "name": "$factory_name",
            "max_children_size": 1, // set to 1 because i only want 1 collection item for each control to render
            "control_ids": "$factory_control_identifiers", // actual controls that will be renderd
            "factory_variables": "$brewing_factory_variables"
          },
          "property_bag": "$factory_binding_values"
        }
      }
    ]
  },

  //the def that centralizes all localization keys
  "text_keys": {
    "type": "panel",
    "property_bag_for_children": "$property_bag_for_children",
    "$property_bag_for_children": {
      "#is_awkward_potion_key": "%brewing.potion.awkward",
      "#is_night_vision_key": "%brewing.potion.nightVision\n§7%brewing.effect.nightVision (3:00)",
      "#is_invisibility_key": "%brewing.potion.invisibility\n§7%brewing.effect.invisibility (3:00)",
      "#is_leaping_key": "%brewing.potion.jump\n§7%brewing.effect.jump (3:00)",
      "#is_fire_resistance_key": "%brewing.potion.fireResistance\n§7%brewing.effect.fireResistance (3:00)",
      "#is_swiftness_key": "%brewing.potion.moveSpeed\n§7%brewing.effect.moveSpeed (3:00)\n\n§5%brewing.effect.whenDrank\n§9+20%% %brewing.effect.moveSpeed",
      "#is_slowness_key": "%brewing.potion.moveSlowdown\n§c%brewing.effect.moveSlowdown (1:30)\n\n§5%brewing.effect.whenDrank\n§c-15%% %brewing.effect.moveSpeed",
      "#is_water_breathing_key": "%brewing.potion.waterBreathing\n§7%brewing.effect.waterBreathing (3:00)",
      "#is_healing_key": "%brewing.potion.heal\n§7%brewing.effect.heal",
      "#is_harming_key": "%brewing.potion.harm\n§c%brewing.effect.harm",
      "#is_poison_key": "%brewing.potion.poison\n§c%brewing.effect.poison (0:45)",
      "#is_regeneration_key": "%brewing.potion.regeneration\n§7%brewing.effect.regeneration (0:45)",
      "#is_strength_key": "%brewing.potion.damageBoost\n§7%brewing.effect.damageBoost (3:00)\n\n§5%brewing.effect.whenDrank\n§9+1.3 %brewing.attribute.attack_damage",
      "#is_weakness_key": "%brewing.potion.weakness\n§c%brewing.effect.weakness (1:30)\n\n§5%brewing.effect.whenDrank\n§c-0.7 %brewing.attribute.attack_damage",
      "#is_turtle_master_key": "%brewing.potion.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.3 (0:20)\n§7%brewing.effect.turtleMaster2 %brewing.potency.2 (0:20)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
      "#is_slow_falling_key": "%brewing.potion.slowFalling\n§7%brewing.effect.slowFalling (1:30)",
      "#is_wind_charging_key": "%brewing.potion.windCharged\n§c%brewing.effect.windCharged (3:00)",
      "#is_weaving_key": "%brewing.potion.weaving\n§c%brewing.effect.weaving (3:00)",
      "#is_oozing_key": "%brewing.potion.oozing\n§c%brewing.effect.oozing (3:00)",
      "#is_infested_key": "%brewing.potion.infested\n§c%brewing.effect.infested (3:00)",

      "#potency_is_leaping_key": "%brewing.potion.jump\n§7%brewing.effect.jump %brewing.potency.1 (1:30)",
      "#potency_is_swiftness_key": "%brewing.potion.moveSpeed\n§7%brewing.effect.moveSpeed %brewing.potency.1 (1:30)\n\n§5%brewing.effect.whenDrank\n§9+40%% %brewing.effect.moveSpeed",
      "#potency_is_slowness_key": "%brewing.potion.moveSlowdown\n§c%brewing.effect.moveSlowdown %brewing.potency.3 (0:20)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
      "#potency_is_healing_key": "%brewing.potion.heal\n§7%brewing.effect.heal %brewing.potency.1",
      "#potency_is_harming_key": "%brewing.potion.harm\n§c%brewing.effect.harm %brewing.potency.1",
      "#potency_is_poison_key": "%brewing.potion.poison\n§c%brewing.effect.poison %brewing.potency.1 (0:22)",
      "#potency_is_regeneration_key": "%brewing.potion.regeneration\n§7%brewing.effect.regeneration %brewing.potency.1 (0:22)",
      "#potency_is_strength_key": "%brewing.potion.damageBoost\n§7%brewing.effect.damageBoost %brewing.potency.1 (1:30)\n\n§5%brewing.effect.whenDrank\n§9+2.99 %brewing.attribute.attack_damage",
      "#potency_is_turtle_master_key": "%brewing.potion.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.5 (0:20)\n§7%brewing.effect.turtleMaster2 %brewing.potency.3 (0:20)\n\n§5%brewing.effect.whenDrank\n§c-90%% %brewing.effect.moveSpeed",

      "#duration_is_night_vision_key": "%brewing.potion.nightVision\n§7%brewing.effect.nightVision (8:00)",
      "#duration_is_invisibility_key": "%brewing.potion.invisibility\n§7%brewing.effect.invisibility (8:00)",
      "#duration_is_leaping_key": "%brewing.potion.jump\n§7%brewing.effect.jump (8:00)",
      "#duration_is_fire_resistance_key": "%brewing.potion.fireResistance\n§7%brewing.effect.fireResistance (8:00)",
      "#duration_is_swiftness_key": "%brewing.potion.moveSpeed\n§7%brewing.effect.moveSpeed (8:00)\n\n§5%brewing.effect.whenDrank\n§9+20%% %brewing.effect.moveSpeed",
      "#duration_is_slowness_key": "%brewing.potion.moveSlowdown\n§c%brewing.effect.moveSlowdown (4:00)\n\n§5%brewing.effect.whenDrank\n§c-15%% %brewing.effect.moveSpeed",
      "#duration_is_water_breathing_key": "%brewing.potion.waterBreathing\n§7%brewing.effect.waterBreathing (8:00)",
      "#duration_is_poison_key": "%brewing.potion.poison\n§c%brewing.effect.poison (2:00)",
      "#duration_is_regeneration_key": "%brewing.potion.regeneration\n§7%brewing.effect.regeneration (2:00)",
      "#duration_is_strength_key": "%brewing.potion.damageBoost\n§7%brewing.effect.damageBoost (8:00)\n\n§5%brewing.effect.whenDrank\n§9+1.3 %brewing.attribute.attack_damage",
      "#duration_is_weakness_key": "%brewing.potion.weakness\n§c%brewing.effect.weakness (4:00)\n\n§5%brewing.effect.whenDrank\n§c-0.7 %brewing.attribute.attack_damage",
      "#duration_is_turtle_master_key": "%brewing.potion.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.3 (0:40)\n§7%brewing.effect.turtleMaster2 %brewing.potency.2 (0:40)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
      "#duration_is_slow_falling_key": "%brewing.potion.slowFalling\n§7%brewing.effect.slowFalling (4:00)",

      //ingredient translation keys
      "#is_fermented_spider_eye_key": "%brewing.ingredient.fermented_spider_eye",
      "#is_turtle_shell_key": "%brewing.ingredient.turtle_helmet",
      "#is_water_bottle_key": "%brewing.potion.emptyPotion",
      "#is_slime_block_key": "%brewing.ingredient.slime",
      "#is_stone_key": "%brewing.ingredient.stone",
      "#is_blaze_powder_key": "%brewing.ingredient.blaze_powder",
      "#is_breeze_rod_key": "%brewing.ingredient.breeze_rod",
      "#is_ghast_tear_key": "%brewing.ingredient.ghast_tear",
      "#is_phantom_membrane_key": "%brewing.ingredient.phantom_membrane",
      "#is_spider_eye_key": "%brewing.ingredient.spider_eye",
      "#is_sugar_key": "%brewing.ingredient.sugar",
      "#is_nether_wart_key": "%brewing.ingredient.nether_wart",
      "#is_golden_carrot_key": "%brewing.ingredient.golden_carrot",
      "#is_magma_cream_key": "%brewing.ingredient.magma_cream",
      "#is_glistering_melon_key": "%brewing.ingredient.speckled_melon",
      "#is_pufferfish_key": "%brewing.ingredient.pufferfish",
      "#is_rabbit_foot_key": "%brewing.ingredient.rabbit_foot",
      "#is_cobweb_key": "%brewing.ingredient.web",
      "#is_gunpowder_key": "%brewing.ingredient.gunpowder",
      "#is_dragons_breath_key": "%brewing.ingredient.dragon_breath",

      //modifier ingredients
      "#is_redstone_key": "%brewing.ingredient.redstone",
      "#is_glowstone_key": "%brewing.ingredient.glowstone_dust"
    },

    "variables": [
      {
        "requires": "($base_id = $brewing_guide:splash_potion)",
        "$property_bag_for_children": {
          "#is_awkward_potion_key": "%brewing.splash.awkward",
          "#is_night_vision_key": "%brewing.splash.nightVision\n§7%brewing.effect.nightVision (3:00)",
          "#is_invisibility_key": "%brewing.splash.invisibility\n§7%brewing.effect.invisibility (3:00)",
          "#is_leaping_key": "%brewing.splash.jump\n§7%brewing.effect.jump (3:00)",
          "#is_fire_resistance_key": "%brewing.splash.fireResistance\n§7%brewing.effect.fireResistance (3:00)",
          "#is_swiftness_key": "%brewing.splash.moveSpeed\n§7%brewing.effect.moveSpeed (3:00)\n\n§5%brewing.effect.whenDrank\n§9+20%% %brewing.effect.moveSpeed",
          "#is_slowness_key": "%brewing.splash.moveSlowdown\n§c%brewing.effect.moveSlowdown (1:30)\n\n§5%brewing.effect.whenDrank\n§c-15%% %brewing.effect.moveSpeed",
          "#is_water_breathing_key": "%brewing.splash.waterBreathing\n§7%brewing.effect.waterBreathing (3:00)",
          "#is_healing_key": "%brewing.splash.heal\n§7%brewing.effect.heal",
          "#is_harming_key": "%brewing.splash.harm\n§c%brewing.effect.harm",
          "#is_poison_key": "%brewing.splash.poison\n§c%brewing.effect.poison (0:45)",
          "#is_regeneration_key": "%brewing.splash.regeneration\n§7%brewing.effect.regeneration (0:45)",
          "#is_strength_key": "%brewing.splash.damageBoost\n§7%brewing.effect.damageBoost (3:00)\n\n§5%brewing.effect.whenDrank\n§9+1.3 %brewing.attribute.attack_damage",
          "#is_weakness_key": "%brewing.splash.weakness\n§c%brewing.effect.weakness (1:30)\n\n§5%brewing.effect.whenDrank\n§c-0.7 %brewing.attribute.attack_damage",
          "#is_turtle_master_key": "%brewing.splash.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.3 (0:20)\n§7%brewing.effect.turtleMaster2 %brewing.potency.2 (0:20)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
          "#is_slow_falling_key": "%brewing.splash.slowFalling\n§7%brewing.effect.slowFalling (1:30)",
          "#is_wind_charging_key": "%brewing.splash.windCharged\n§c%brewing.effect.windCharged (3:00)",
          "#is_weaving_key": "%brewing.splash.weaving\n§c%brewing.effect.weaving (3:00)",
          "#is_oozing_key": "%brewing.splash.oozing\n§c%brewing.effect.oozing (3:00)",
          "#is_infested_key": "%brewing.splash.infested\n§c%brewing.effect.infested (3:00)",

          "#potency_is_leaping_key": "%brewing.splash.jump\n§7%brewing.effect.jump %brewing.potency.1 (1:30)",
          "#potency_is_swiftness_key": "%brewing.splash.moveSpeed\n§7%brewing.effect.moveSpeed %brewing.potency.1 (1:30)\n\n§5%brewing.effect.whenDrank\n§9+40%% %brewing.effect.moveSpeed",
          "#potency_is_slowness_key": "%brewing.splash.moveSlowdown\n§c%brewing.effect.moveSlowdown %brewing.potency.3 (0:20)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
          "#potency_is_healing_key": "%brewing.splash.heal\n§7%brewing.effect.heal %brewing.potency.1",
          "#potency_is_harming_key": "%brewing.splash.harm\n§c%brewing.effect.harm %brewing.potency.1",
          "#potency_is_poison_key": "%brewing.splash.poison\n§c%brewing.effect.poison %brewing.potency.1 (0:22)",
          "#potency_is_regeneration_key": "%brewing.splash.regeneration\n§7%brewing.effect.regeneration %brewing.potency.1 (0:22)",
          "#potency_is_strength_key": "%brewing.splash.damageBoost\n§7%brewing.effect.damageBoost %brewing.potency.1 (1:30)\n\n§5%brewing.effect.whenDrank\n§9+2.99 %brewing.attribute.attack_damage",
          "#potency_is_turtle_master_key": "%brewing.splash.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.5 (0:20)\n§7%brewing.effect.turtleMaster2 %brewing.potency.3 (0:20)\n\n§5%brewing.effect.whenDrank\n§c-90%% %brewing.effect.moveSpeed",

          "#duration_is_night_vision_key": "%brewing.splash.nightVision\n§7%brewing.effect.nightVision (8:00)",
          "#duration_is_invisibility_key": "%brewing.splash.invisibility\n§7%brewing.effect.invisibility (8:00)",
          "#duration_is_leaping_key": "%brewing.splash.jump\n§7%brewing.effect.jump (8:00)",
          "#duration_is_fire_resistance_key": "%brewing.splash.fireResistance\n§7%brewing.effect.fireResistance (8:00)",
          "#duration_is_swiftness_key": "%brewing.splash.moveSpeed\n§7%brewing.effect.moveSpeed (8:00)\n\n§5%brewing.effect.whenDrank\n§9+20%% %brewing.effect.moveSpeed",
          "#duration_is_slowness_key": "%brewing.splash.moveSlowdown\n§c%brewing.effect.moveSlowdown (4:00)\n\n§5%brewing.effect.whenDrank\n§c-15%% %brewing.effect.moveSpeed",
          "#duration_is_water_breathing_key": "%brewing.splash.waterBreathing\n§7%brewing.effect.waterBreathing (8:00)",
          "#duration_is_poison_key": "%brewing.splash.poison\n§c%brewing.effect.poison (2:00)",
          "#duration_is_regeneration_key": "%brewing.splash.regeneration\n§7%brewing.effect.regeneration (2:00)",
          "#duration_is_strength_key": "%brewing.splash.damageBoost\n§7%brewing.effect.damageBoost (8:00)\n\n§5%brewing.effect.whenDrank\n§9+1.3 %brewing.attribute.attack_damage",
          "#duration_is_weakness_key": "%brewing.splash.weakness\n§c%brewing.effect.weakness (4:00)\n\n§5%brewing.effect.whenDrank\n§c-0.7 %brewing.attribute.attack_damage",
          "#duration_is_turtle_master_key": "%brewing.splash.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.3 (0:40)\n§7%brewing.effect.turtleMaster2 %brewing.potency.2 (0:40)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
          "#duration_is_slow_falling_key": "%brewing.splash.slowFalling\n§7%brewing.effect.slowFalling (4:00)",

          //ingredient translation keys
          "#is_fermented_spider_eye_key": "%brewing.ingredient.fermented_spider_eye",
          "#is_turtle_shell_key": "%brewing.ingredient.turtle_helmet",
          "#is_water_bottle_key": "%brewing.potion.emptyPotion",
          "#is_slime_block_key": "%brewing.ingredient.slime",
          "#is_stone_key": "%brewing.ingredient.stone",
          "#is_blaze_powder_key": "%brewing.ingredient.blaze_powder",
          "#is_breeze_rod_key": "%brewing.ingredient.breeze_rod",
          "#is_ghast_tear_key": "%brewing.ingredient.ghast_tear",
          "#is_phantom_membrane_key": "%brewing.ingredient.phantom_membrane",
          "#is_spider_eye_key": "%brewing.ingredient.spider_eye",
          "#is_sugar_key": "%brewing.ingredient.sugar",
          "#is_nether_wart_key": "%brewing.ingredient.nether_wart",
          "#is_golden_carrot_key": "%brewing.ingredient.golden_carrot",
          "#is_magma_cream_key": "%brewing.ingredient.magma_cream",
          "#is_glistering_melon_key": "%brewing.ingredient.speckled_melon",
          "#is_pufferfish_key": "%brewing.ingredient.pufferfish",
          "#is_rabbit_foot_key": "%brewing.ingredient.rabbit_foot",
          "#is_cobweb_key": "%brewing.ingredient.web",
          "#is_gunpowder_key": "%brewing.ingredient.gunpowder",
          "#is_dragons_breath_key": "%brewing.ingredient.dragon_breath",

          //modifier ingredients
          "#is_redstone_key": "%brewing.ingredient.redstone",
          "#is_glowstone_key": "%brewing.ingredient.glowstone_dust"
        }
      },
      {
        "requires": "($base_id = $brewing_guide:lingering_potion)",
        "$property_bag_for_children": {
          "#is_awkward_potion_key": "%brewing.linger.awkward",
          "#is_night_vision_key": "%brewing.linger.nightVision\n§7%brewing.effect.nightVision (0:45)",
          "#is_invisibility_key": "%brewing.linger.invisibility\n§7%brewing.effect.invisibility (0:45)",
          "#is_leaping_key": "%brewing.linger.jump\n§7%brewing.effect.jump (0:45)",
          "#is_fire_resistance_key": "%brewing.linger.fireResistance\n§7%brewing.effect.fireResistance (0:45)",
          "#is_swiftness_key": "%brewing.linger.moveSpeed\n§7%brewing.effect.moveSpeed (0:45)\n\n§5%brewing.effect.whenDrank\n§9+20%% %brewing.effect.moveSpeed",
          "#is_slowness_key": "%brewing.linger.moveSlowdown\n§c%brewing.effect.moveSlowdown (0:22)\n\n§5%brewing.effect.whenDrank\n§c-15%% %brewing.effect.moveSpeed",
          "#is_water_breathing_key": "%brewing.linger.waterBreathing\n§7%brewing.effect.waterBreathing (0:45)",
          "#is_healing_key": "%brewing.linger.heal\n§7%brewing.effect.heal",
          "#is_harming_key": "%brewing.linger.harm\n§c%brewing.effect.harm",
          "#is_poison_key": "%brewing.linger.poison\n§c%brewing.effect.poison (0:11)",
          "#is_regeneration_key": "%brewing.linger.regeneration\n§7%brewing.effect.regeneration (0:11)",
          "#is_strength_key": "%brewing.linger.damageBoost\n§7%brewing.effect.damageBoost (0:45)\n\n§5%brewing.effect.whenDrank\n§9+1.3 %brewing.attribute.attack_damage",
          "#is_weakness_key": "%brewing.linger.weakness\n§c%brewing.effect.weakness (0:22)\n\n§5%brewing.effect.whenDrank\n§c-0.7 %brewing.attribute.attack_damage",
          "#is_turtle_master_key": "%brewing.linger.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.3 (0:05)\n§7%brewing.effect.turtleMaster2 %brewing.potency.2 (0:05)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
          "#is_slow_falling_key": "%brewing.linger.slowFalling\n§7%brewing.effect.slowFalling (0:22)",
          "#is_wind_charging_key": "%brewing.linger.windCharged\n§c%brewing.effect.windCharged (0:45)",
          "#is_weaving_key": "%brewing.linger.weaving\n§c%brewing.effect.weaving (0:45)",
          "#is_oozing_key": "%brewing.linger.oozing\n§c%brewing.effect.oozing (0:45)",
          "#is_infested_key": "%brewing.linger.infested\n§c%brewing.effect.infested (0:45)",

          "#potency_is_leaping_key": "%brewing.linger.jump\n§7%brewing.effect.jump %brewing.potency.1 (0:22)",
          "#potency_is_swiftness_key": "%brewing.linger.moveSpeed\n§7%brewing.effect.moveSpeed %brewing.potency.1 (0:22)\n\n§5%brewing.effect.whenDrank\n§9+40%% %brewing.effect.moveSpeed",
          "#potency_is_slowness_key": "%brewing.linger.moveSlowdown\n§c%brewing.effect.moveSlowdown %brewing.potency.3 (0:05)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
          "#potency_is_healing_key": "%brewing.linger.heal\n§7%brewing.effect.heal %brewing.potency.1",
          "#potency_is_harming_key": "%brewing.linger.harm\n§c%brewing.effect.harm %brewing.potency.1",
          "#potency_is_poison_key": "%brewing.linger.poison\n§c%brewing.effect.poison %brewing.potency.1 (0:05)",
          "#potency_is_regeneration_key": "%brewing.linger.regeneration\n§7%brewing.effect.regeneration %brewing.potency.1 (0:05)",
          "#potency_is_strength_key": "%brewing.linger.damageBoost\n§7%brewing.effect.damageBoost %brewing.potency.1 (0:22)\n\n§5%brewing.effect.whenDrank\n§9+2.99 %brewing.attribute.attack_damage",
          "#potency_is_turtle_master_key": "%brewing.linger.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.5 (0:05)\n§7%brewing.effect.turtleMaster2 %brewing.potency.3 (0:05)\n\n§5%brewing.effect.whenDrank\n§c-90%% %brewing.effect.moveSpeed",

          "#duration_is_night_vision_key": "%brewing.linger.nightVision\n§7%brewing.effect.nightVision (2:00)",
          "#duration_is_invisibility_key": "%brewing.linger.invisibility\n§7%brewing.effect.invisibility (2:00)",
          "#duration_is_leaping_key": "%brewing.linger.jump\n§7%brewing.effect.jump (2:00)",
          "#duration_is_fire_resistance_key": "%brewing.linger.fireResistance\n§7%brewing.effect.fireResistance (2:00)",
          "#duration_is_swiftness_key": "%brewing.linger.moveSpeed\n§7%brewing.effect.moveSpeed (2:00)\n\n§5%brewing.effect.whenDrank\n§9+20%% %brewing.effect.moveSpeed",
          "#duration_is_slowness_key": "%brewing.linger.moveSlowdown\n§c%brewing.effect.moveSlowdown (1:00)\n\n§5%brewing.effect.whenDrank\n§c-15%% %brewing.effect.moveSpeed",
          "#duration_is_water_breathing_key": "%brewing.linger.waterBreathing\n§7%brewing.effect.waterBreathing (2:00)",
          "#duration_is_poison_key": "%brewing.linger.poison\n§c%brewing.effect.poison (0:30)",
          "#duration_is_regeneration_key": "%brewing.linger.regeneration\n§7%brewing.effect.regeneration (0:30)",
          "#duration_is_strength_key": "%brewing.linger.damageBoost\n§7%brewing.effect.damageBoost (2:00)\n\n§5%brewing.effect.whenDrank\n§9+1.3 %brewing.attribute.attack_damage",
          "#duration_is_weakness_key": "%brewing.linger.weakness\n§c%brewing.effect.weakness (1:00)\n\n§5%brewing.effect.whenDrank\n§c-0.7 %brewing.attribute.attack_damage",
          "#duration_is_turtle_master_key": "%brewing.linger.turtleMaster\n§c%brewing.effect.turtleMaster %brewing.potency.3 (0:10)\n§7%brewing.effect.turtleMaster2 %brewing.potency.2 (0:10)\n\n§5%brewing.effect.whenDrank\n§c-60%% %brewing.effect.moveSpeed",
          "#duration_is_slow_falling_key": "%brewing.linger.slowFalling\n§7%brewing.effect.slowFalling (1:00)",

          //ingredient translation keys
          "#is_fermented_spider_eye_key": "%brewing.ingredient.fermented_spider_eye",
          "#is_turtle_shell_key": "%brewing.ingredient.turtle_helmet",
          "#is_water_bottle_key": "%brewing.potion.emptyPotion",
          "#is_slime_block_key": "%brewing.ingredient.slime",
          "#is_stone_key": "%brewing.ingredient.stone",
          "#is_blaze_powder_key": "%brewing.ingredient.blaze_powder",
          "#is_breeze_rod_key": "%brewing.ingredient.breeze_rod",
          "#is_ghast_tear_key": "%brewing.ingredient.ghast_tear",
          "#is_phantom_membrane_key": "%brewing.ingredient.phantom_membrane",
          "#is_spider_eye_key": "%brewing.ingredient.spider_eye",
          "#is_sugar_key": "%brewing.ingredient.sugar",
          "#is_nether_wart_key": "%brewing.ingredient.nether_wart",
          "#is_golden_carrot_key": "%brewing.ingredient.golden_carrot",
          "#is_magma_cream_key": "%brewing.ingredient.magma_cream",
          "#is_glistering_melon_key": "%brewing.ingredient.speckled_melon",
          "#is_pufferfish_key": "%brewing.ingredient.pufferfish",
          "#is_rabbit_foot_key": "%brewing.ingredient.rabbit_foot",
          "#is_cobweb_key": "%brewing.ingredient.web",
          "#is_gunpowder_key": "%brewing.ingredient.gunpowder",
          "#is_dragons_breath_key": "%brewing.ingredient.dragon_breath",

          //modifier ingredients
          "#is_redstone_key": "%brewing.ingredient.redstone",
          "#is_glowstone_key": "%brewing.ingredient.glowstone_dust"
        }
      }
    ]
  },
  "custom_hover_text_renderer": {
    "type": "button",
    "size": ["100% - 0.1px", "100% - 0.1px"], //was going to say something but i forgot what - TODO : add explanation X2
    "hover_control": "custom_tooltip",
    "consume_event": false,
    "consume_hover_events": false,
    "$translation_keys": "('#' + $potion_prefix + $potion_key_type)",
    "layer": 5,
    /*
      to translate multiple keys in 1 label use % to concat them like '%somekey%someotherkey'  
      the % denotes a new translateable point with this you can translate text and add 
      custom text with bindings in the same label
    */
    "$tooltip_anchor|default": "top_left",
    "$tooltip_offset|default": [20, 0],
    "controls": [
      {
        "follow": {
          "type": "input_panel",
          "size": [18, 18],
          "layer": 200,
          /*
            since this element is not stuck in the visible state it is always visible meaning the tooltip dosent jump around on rehover
          */
          "follows_cursor": true,
          "consume_hover_events": false,
          "always_listen_to_input": false,
          "always_handle_pointer": true,
          "focus_enabled": false,
          "focus_magnet_enabled": false,
          "prevent_touch_input": true,
          "button_mappings": [],
          "controls": [
            {
              "custom_tooltip@brewing_global.empty_image": {
                "texture": "textures/ui/purpleBorder",
                "size": ["100%c + 10px", "100%c + 8px"],
                "nineslice_size": 4,
                "offset": "$tooltip_offset",
                "anchor_from": "$tooltip_anchor",
                "anchor_to": "$tooltip_anchor",
                "allow_clipping": false,
                "controls": [
                  {
                    "hover_text_label": {
                      "type": "label",
                      "text": "$translation_keys",
                      "shadow": false,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": ["default", "default"],
                      "layer": 2
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "empty_panel": { "type": "panel" },
  "empty_label": { "type": "label" },
  "empty_image": { "type": "image" },
  "empty_stack": { "type": "stack_panel" },
  "empty_grid": { "type": "grid" },
  "empty_collection": { "type": "collection_panel" },
  "custom_renderer": {
    "type": "custom",
    "renderer": "$type"
  },
  "root_panel": {
    "type": "input_panel",
    "button_mappings": [
      { "from_button_id": "button.controller_back","to_button_id": "button.container_reset_held","mapping_type": "pressed","ignored": "(not $is_ps4)"},
      { "from_button_id": "button.menu_select","to_button_id": "button.container_reset_held","mapping_type": "pressed"},
      { "from_button_id": "button.menu_secondary_select","to_button_id": "button.container_reset_held","mapping_type": "pressed"},
      { "from_button_id": "button.menu_ok", "to_button_id": "button.container_reset_held", "mapping_type": "pressed" },
      { "from_button_id": "button.return", "to_button_id": "button.return", "mapping_type": "global" },
      { "from_button_id": "button.arrow_up", "to_button_id": "button.arrow_key", "mapping_type": "global" },
      { "from_button_id": "button.arrow_down", "to_button_id": "button.arrow_key", "mapping_type": "global" },
      { "from_button_id": "button.arrow_left", "to_button_id": "button.arrow_key", "mapping_type": "global" },
      { "from_button_id": "button.arrow_right", "to_button_id": "button.arrow_key", "mapping_type": "global" },
      { "from_button_id": "button.controller_select", "to_button_id": "button.container_reset_held", "mapping_type": "pressed" },
      { "from_button_id": "button.controller_secondary_select", "to_button_id": "button.container_reset_held", "mapping_type": "pressed" },
      { "from_button_id": "button.turn_up", "to_button_id": "button.scroll_up", "mapping_type": "global" },
      { "from_button_id": "button.turn_down", "to_button_id": "button.scroll_down", "mapping_type": "global" },
      { "from_button_id": "button.turn_left", "to_button_id": "button.scroll_left", "mapping_type": "global" },
      { "from_button_id": "button.turn_right", "to_button_id": "button.scroll_right", "mapping_type": "global" },
      { "from_button_id": "button.inventory_left", "to_button_id": "button.inventory_left", "mapping_type": "global" },
      { "from_button_id": "button.inventory_right", "to_button_id": "button.inventory_right", "mapping_type": "global" }
    ]
  }
}
