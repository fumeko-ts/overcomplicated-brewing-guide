{
  "namespace": "brewing_global",
  "item_renderer@global.custom_renderer": {
    "$type": "inventory_item_renderer",
    "size": [16, 16],
    "anchor_from": "center",
    "anchor_to": "center",
    "property_bag": {
      "#item_id_aux": "(($base_id * 65536) + $remainder)"
    }
  },

  "item_slot_variables": {
    "always_listen_to_input": true,
    "consume_hover_events": false
  },

  "container_item_slot_overlay@toggle.radio_toggle": {
    "size": [18, 18],
    "$button_volume": 0,
    "$toggle_group_forced_index": -1,
    "$toggle_name": "brewing_items",
    "$toggle_control_name": "brewing_reset",
    "$toggle_binding_value": "#item_brewing_reset",
    "$toggle_variables": "brewing_global.item_slot_variables",
    "variables": {
      "requires": "$touch",
      "$mapping_type": "double_pressed"
    },
    "$controls": [
      {
        "white_overlay@global.empty_image": {
          "size": [18, 18],
          "nineslice_size": 2,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png",
          "layer": 12,
          "alpha": 0.1915
        }
      },
      {
        "uncraftable_slot@global.empty_image": {
          "size": [18, 18],
          "nineslice_size": 2,
          "color": [0.996, 0.0, 0.008],
          "alpha": 0.19,
          "layer": 5,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png"
        }
      },
      {
        "hover_text_element@brewing_global.custom_hover_text_renderer": {
          "size": [18, 18]
        }
      },
      {
        "renderer@brewing_global.item_renderer": {
          "layer": 6
        }
      }
    ]
  },

  // factory is done like this to make it so i can re-use it without redeclairing, a new factory
  "factory@brewing_global.text_keys": {
    "size": [18, 18],

    "$remainder|default": 0,
    "$base_id|default": 0,

    "$potion_prefix|default": "",
    "$factory_name|default": "Minecraft", // set collection name so i can use #collection_index on the elements that use this with the same collection name(it can be almost eanything even !!LEMON!!)

    "$awkward_potion_action|default": "",
    "$night_vision_action|default": "",
    "$invisibility_action|default": "",
    "$leaping_action|default": "",
    "$fire_resistance_action|default": "",
    "$swiftness_action|default": "",
    "$slowness_action|default": "",
    "$water_breathing_action|default": "",
    "$healing_action|default": "",
    "$harming_action|default": "",
    "$poison_action|default": "",
    "$regeneration_action|default": "",
    "$strength_action|default": "",
    "$weakness_action|default": "",
    "$turtle_master_action|default": "",
    "$slow_falling_action|default": "",
    "$wind_charging_action|default": "",
    "$weaving_action|default": "",
    "$oozing_action|default": "",
    "$infestation_action|default": "",

    "$factory_control_identifiers|default": {
      "is_awkward_potion": "$awkward_potion_action",
      "is_night_vision": "$night_vision_action",
      "is_invisibility": "$invisibility_action",
      "is_leaping": "$leaping_action",
      "is_fire_resistance": "$fire_resistance_action",
      "is_swiftness": "$swiftness_action",
      "is_slowness": "$slowness_action",
      "is_water_breathing": "$water_breathing_action",
      "is_healing": "$healing_action",
      "is_harming": "$harming_action",
      "is_poison": "$poison_action",
      "is_regeneration": "$regeneration_action",
      "is_strength": "$strength_action",
      "is_weakness": "$weakness_action",
      "is_turtle_master": "$turtle_master_action",
      "is_slow_falling": "$slow_falling_action",
      "is_wind_charging": "$wind_charging_action",
      "is_weaving": "$weaving_action",
      "is_oozing": "$oozing_action",
      "is_infestation": "$infestation_action"
    },

    "$factory_binding_values|default": {
      "#item_index_1": ["is_awkward_potion"],
      "#item_index_2": ["is_night_vision"],
      "#item_index_3": ["is_invisibility"],
      "#item_index_4": ["is_leaping"],
      "#item_index_5": ["is_fire_resistance"],
      "#item_index_6": ["is_swiftness"],
      "#item_index_7": ["is_slowness"],
      "#item_index_8": ["is_water_breathing"],
      "#item_index_9": ["is_healing"],
      "#item_index_10": ["is_harming"],
      "#item_index_11": ["is_poison"],
      "#item_index_12": ["is_regeneration"],
      "#item_index_13": ["is_strength"],
      "#item_index_14": ["is_weakness"],
      "#item_index_15": ["is_turtle_master"],
      "#item_index_16": ["is_slow_falling"],
      "#item_index_17": ["is_wind_charging"],
      "#item_index_18": ["is_weaving"],
      "#item_index_19": ["is_oozing"],
      "#item_index_20": ["is_infestation"]
    },
    "$factory_binding_refrence|default": "factory_bindings.bindings", // used to customise whats input for the #collection_length (collection length accepts a array like this ["control_id_you_want_to_render"])

    "$brewing_factory_variables|default": [
      // passes static values from above to the the generated controls and inner parts
      "$awkward_potion_action",
      "$night_vision_action",
      "$invisibility_action",
      "$leaping_action",
      "$fire_resistance_action",
      "$swiftness_action",
      "$slowness_action",
      "$water_breathing_action",
      "$healing_action",
      "$harming_action",
      "$poison_action",
      "$regeneration_action",
      "$strength_action",
      "$weakness_action",
      "$turtle_master_action",
      "$slow_falling_action",
      "$wind_charging_action",
      "$weaving_action",
      "$oozing_action",
      "$infestation_action",
      "$base_id",
      "$remainder",
      "$item_collection",

      "$potion_prefix"
    ],

    "controls": [
      {
        "$factory_name@$factory_binding_refrence": {
          "type": "collection_panel",
          "size": [18, 18],
          "collection_name": "$factory_name", // same as the factory name for simplicity
          "factory": {
            "name": "$factory_name",
            "max_children_size": 1, // set to 1 because i only want 1 collection item for each control to render
            "control_ids": "$factory_control_identifiers", // actual controls that will be renderd
            "factory_variables": "$brewing_factory_variables"
          },
          "property_bag": "$factory_binding_values"
        }
      }
    ]
  },

  //the def that centralizes all localization keys
  "text_keys": {
    "type": "panel",
    "property_bag_for_children": "$property_bag_for_children",
    "$property_bag_for_children": {
      "#is_awkward_potion_key": "%potion.awkward.name",
      "#is_night_vision_key": "%potion.nightVision.name\n§7%potion.nightVision (3:00)",
      "#is_invisibility_key": "%potion.invisibility.name\n§7%potion.invisibility (3:00)",
      "#is_leaping_key": "%potion.jump.name\n§7%potion.jump (3:00)",
      "#is_fire_resistance_key": "%potion.fireResistance.name\n§7%potion.fireResistance (3:00)",
      "#is_swiftness_key": "%potion.moveSpeed.name\n§7%potion.moveSpeed (3:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
      "#is_slowness_key": "%potion.moveSlowdown.name\n§c%potion.moveSlowdown (1:30)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
      "#is_water_breathing_key": "%potion.waterBreathing.name\n§7%potion.waterBreathing (3:00)",
      "#is_healing_key": "%potion.heal.name\n§7%potion.heal ",
      "#is_harming_key": "%potion.harm.name\n§c%potion.harm ",
      "#is_poison_key": "%potion.poison.name\n§c%potion.poison (0:45)",
      "#is_regeneration_key": "%potion.regeneration.name\n§7%potion.regeneration (0:45)",
      "#is_strength_key": "%potion.damageBoost.name\n§7%potion.damageBoost (3:00)\n\n§5%potion.effects.whenDrank\n§9+1.3 %attribute.name.generic.attackDamage",
      "#is_weakness_key": "%potion.weakness.name\n§c%potion.weakness (1:30)\n\n§5%potion.effects.whenDrank\n§c-0.7 %attribute.name.generic.attackDamage",
      "#is_turtle_master_key": "%potion.turtleMaster.name\n§c%potion.turtleMaster %potion.potency.3 (0:20)\n§7%potion.turtleMaster2 %potion.potency.2 (0:20)\n\n§5%potion.effects.whenDrank\n§c-60%% %potion.moveSpeed",
      "#is_slow_falling_key": "%potion.slowFalling.name\n§7%potion.slowFalling (1:30)",
      "#is_wind_charging_key": "%potion.windCharged.name\n§c%potion.windCharged (3:00)",
      "#is_weaving_key": "%potion.weaving.name\n§c%potion.weaving (3:00)",
      "#is_oozing_key": "%potion.oozing.name\n§c%potion.oozing (3:00)",
      "#is_infested_key": "%potion.infested.name\n§c%potion.infested (3:00)",

      "#potency_is_leaping_key": "%potion.jump.name\n§7%potion.jump %potion.potency.1 (1:30)",
      "#potency_is_swiftness_key": "%potion.moveSpeed.name\n§7%potion.moveSpeed %potion.potency.1 (1:30)\n\n§5%potion.effects.whenDrank\n§9+40%% %potion.moveSpeed",
      "#potency_is_slowness_key": "%potion.moveSlowdown.name\n§c%potion.moveSlowdown %potion.potency.3 (0:20)\n\n§5%potion.effects.whenDrank\n§c-60%% %potion.moveSpeed",
      "#potency_is_healing_key": "%potion.heal.name\n§7%potion.heal %potion.potency.1",
      "#potency_is_harming_key": "%potion.harm.name\n§c%potion.harm %potion.potency.1",
      "#potency_is_poison_key": "%potion.poison.name\n§c%potion.poison %potion.potency.1 (0:22)",
      "#potency_is_regeneration_key": "%potion.regeneration.name\n§7%potion.regeneration %potion.potency.1 (0:22)",
      "#potency_is_strength_key": "%potion.damageBoost.name\n§7%potion.damageBoost %potion.potency.1 (1:30)\n\n§5%potion.effects.whenDrank\n§9+2.99 %attribute.name.generic.attackDamage",
      "#potency_is_turtle_master_key": "%potion.turtleMaster.name\n§c%potion.turtleMaster %potion.potency.5 (0:20)\n§7%potion.turtleMaster2 %potion.potency.3 (0:20)\n\n§5%potion.effects.whenDrank\n§c-90%% %potion.moveSpeed",

      "#duration_is_night_vision_key": "%potion.nightVision.name\n§7%potion.nightVision (8:00)",
      "#duration_is_invisibility_key": "%potion.invisibility.name\n§7%potion.invisibility (8:00)",
      "#duration_is_leaping_key": "%potion.jump.name\n§7%potion.jump (8:00)",
      "#duration_is_fire_resistance_key": "%potion.fireResistance.name\n§7%potion.fireResistance (8:00)",
      "#duration_is_swiftness_key": "%potion.moveSpeed.name\n§7%potion.moveSpeed (8:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
      "#duration_is_slowness_key": "%potion.moveSlowdown.name\n§c%potion.moveSlowdown (4:00)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
      "#duration_is_water_breathing_key": "%potion.waterBreathing.name\n§7%potion.waterBreathing (8:00)",
      "#duration_is_poison_key": "%potion.poison.name\n§c%potion.poison (2:00)",
      "#duration_is_regeneration_key": "%potion.regeneration.name\n§7%potion.regeneration (2:00)",
      "#duration_is_strength_key": "%potion.damageBoost.name\n§7%potion.damageBoost (8:00)\n\n§5%potion.effects.whenDrank\n§9+1.3 %attribute.name.generic.attackDamage",
      "#duration_is_weakness_key": "%potion.weakness.name\n§c%potion.weakness (4:00)\n\n§5%potion.effects.whenDrank\n§c-0.7 %attribute.name.generic.attackDamage",
      "#duration_is_turtle_master_key": "%potion.turtleMaster.name\n§c%potion.turtleMaster %potion.potency.3 (0:40)\n§7%potion.turtleMaster2 %potion.potency.2 (0:40)\n\n§5%potion.effects.whenDrank\n§c-60%% %potion.moveSpeed",
      "#duration_is_slow_falling_key": "%potion.slowFalling.name\n§7%potion.slowFalling (4:00)",

      //ingredient translation keys
      "#is_fermented_spider_eye_key": "%item.fermented_spider_eye.name",
      "#is_turtle_shell_key": "%item.turtle_helmet.name",
      "#is_water_bottle_key": "%potion.emptyPotion.name",
      "#is_slime_block_key": "%tile.slime.name",
      "#is_stone_key": "%tile.stone.stone.name",
      "#is_blaze_powder_key": "%item.blaze_powder.name",
      "#is_breeze_rod_key": "%item.breeze_rod.name",
      "#is_ghast_tear_key": "%item.ghast_tear.name",
      "#is_phantom_membrane_key": "%item.phantom_membrane.name",
      "#is_spider_eye_key": "%item.spider_eye.name",
      "#is_sugar_key": "%item.sugar.name",
      "#is_nether_wart_key": "%item.nether_wart.name",
      "#is_golden_carrot_key": "%item.golden_carrot.name",
      "#is_magma_cream_key": "%item.magma_cream.name",
      "#is_glistering_melon_key": "%item.speckled_melon.name",
      "#is_pufferfish_key": "%item.pufferfish.name",
      "#is_rabbit_foot_key": "%item.rabbit_foot.name",
      "#is_cobweb_key": "%tile.web.name",
      "#is_gunpowder_key": "%item.gunpowder.name",
      "#is_dragons_breath_key": "%item.dragon_breath.name",

      //modifier ingredients
      "#is_redstone_key": "%item.redstone.name",
      "#is_glowstone_key": "%item.glowstone_dust.name"
    },

    "variables": [
      {
        "requires": "($base_id = $brewing_guide:splash_potion)",
        "$property_bag_for_children": {
          "#is_awkward_potion_key": "%potion.awkward.splash.name",
          "#is_night_vision_key": "%potion.nightVision.splash.name\n§7%potion.nightVision (3:00)",
          "#is_invisibility_key": "%potion.invisibility.splash.name\n§7%potion.invisibility (3:00)",
          "#is_leaping_key": "%potion.jump.splash.name\n§7%potion.jump (3:00)",
          "#is_fire_resistance_key": "%potion.fireResistance.splash.name\n§7%potion.fireResistance (3:00)",
          "#is_swiftness_key": "%potion.moveSpeed.splash.name\n§7%potion.moveSpeed (3:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
          "#is_slowness_key": "%potion.moveSlowdown.splash.name\n§c%potion.moveSlowdown (1:30)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
          "#is_water_breathing_key": "%potion.waterBreathing.splash.name\n§7%potion.waterBreathing (3:00)",
          "#is_healing_key": "%potion.heal.splash.name\n§7%potion.heal ",
          "#is_harming_key": "%potion.harm.splash.name\n§c%potion.harm ",
          "#is_poison_key": "%potion.poison.splash.name\n§c%potion.poison (0:45)",
          "#is_regeneration_key": "%potion.regeneration.splash.name\n§7%potion.regeneration (0:45)",
          "#is_strength_key": "%potion.damageBoost.splash.name\n§7%potion.damageBoost (3:00)\n\n§5%potion.effects.whenDrank\n§9+1.3 %attribute.name.generic.attackDamage",
          "#is_weakness_key": "%potion.weakness.splash.name\n§c%potion.weakness (1:30)\n\n§5%potion.effects.whenDrank\n§c-0.7 %attribute.name.generic.attackDamage",
          "#is_turtle_master_key": "%potion.turtleMaster.splash.name\n§c%potion.turtleMaster %potion.potency.3 (0:20)\n§7%potion.turtleMaster2 %potion.potency.2 (0:20)\n\n§5%potion.effects.whenDrank\n§c-60%% %potion.moveSpeed",
          "#is_slow_falling_key": "%potion.slowFalling.splash.name\n§7%potion.slowFalling (1:30)",
          "#is_wind_charging_key": "%potion.windCharged.splash.name\n§c%potion.windCharged (3:00)",
          "#is_weaving_key": "%potion.weaving.splash.name\n§c%potion.weaving (3:00)",
          "#is_oozing_key": "%potion.oozing.splash.name\n§c%potion.oozing (3:00)",
          "#is_infested_key": "%potion.infested.splash.name\n§c%potion.infested (3:00)",

          "#potency_is_leaping_key": "%potion.jump.splash.name\n§7%potion.jump %potion.potency.1 (1:30)",
          "#potency_is_swiftness_key": "%potion.moveSpeed.splash.name\n§7%potion.moveSpeed %potion.potency.1 (1:30)\n\n§5%potion.effects.whenDrank\n§9+40%% %potion.moveSpeed",
          "#potency_is_slowness_key": "%potion.moveSlowdown.splash.name\n§c%potion.moveSlowdown %potion.potency.3 (0:20)\n\n§5%potion.effects.whenDrank\n§c-60%% %potion.moveSpeed",
          "#potency_is_healing_key": "%potion.heal.splash.name\n§7%potion.heal %potion.potency.1",
          "#potency_is_harming_key": "%potion.harm.splash.name\n§c%potion.harm %potion.potency.1",
          "#potency_is_poison_key": "%potion.poison.splash.name\n§c%potion.poison %potion.potency.1 (0:22)",
          "#potency_is_regeneration_key": "%potion.regeneration.splash.name\n§7%potion.regeneration %potion.potency.1 (0:22)",
          "#potency_is_strength_key": "%potion.damageBoost.splash.name\n§7%potion.damageBoost %potion.potency.1 (1:30)\n\n§5%potion.effects.whenDrank\n§9+2.99 %attribute.name.generic.attackDamage",
          "#potency_is_turtle_master_key": "%potion.turtleMaster.splash.name\n§c%potion.turtleMaster %potion.potency.5 (0:20)\n§7%potion.turtleMaster2 %potion.potency.3 (0:20)\n\n§5%potion.effects.whenDrank\n§c-90%% %potion.moveSpeed",

          "#duration_is_night_vision_key": "%potion.nightVision.splash.name\n§7%potion.nightVision (8:00)",
          "#duration_is_invisibility_key": "%potion.invisibility.splash.name\n§7%potion.invisibility (8:00)",
          "#duration_is_leaping_key": "%potion.jump.splash.name\n§7%potion.jump (8:00)",
          "#duration_is_fire_resistance_key": "%potion.fireResistance.splash.name\n§7%potion.fireResistance (8:00)",
          "#duration_is_swiftness_key": "%potion.moveSpeed.splash.name\n§7%potion.moveSpeed (8:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
          "#duration_is_slowness_key": "%potion.moveSlowdown.splash.name\n§c%potion.moveSlowdown (4:00)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
          "#duration_is_water_breathing_key": "%potion.waterBreathing.splash.name\n§7%potion.waterBreathing (8:00)",
          "#duration_is_poison_key": "%potion.poison.splash.name\n§c%potion.poison (2:00)",
          "#duration_is_regeneration_key": "%potion.regeneration.splash.name\n§7%potion.regeneration (2:00)",
          "#duration_is_strength_key": "%potion.damageBoost.splash.name\n§7%potion.damageBoost (8:00)\n\n§5%potion.effects.whenDrank\n§9+1.3 %attribute.name.generic.attackDamage",
          "#duration_is_weakness_key": "%potion.weakness.splash.name\n§c%potion.weakness (4:00)\n\n§5%potion.effects.whenDrank\n§c-0.7 %attribute.name.generic.attackDamage",
          "#duration_is_turtle_master_key": "%potion.turtleMaster.splash.name\n§c%potion.turtleMaster %potion.potency.3 (0:40)\n§7%potion.turtleMaster2 %potion.potency.2 (0:40)\n\n§5%potion.effects.whenDrank\n§c-60%% %potion.moveSpeed",
          "#duration_is_slow_falling_key": "%potion.slowFalling.splash.name\n§7%potion.slowFalling (4:00)",

          //ingredient translation keys
          "#is_fermented_spider_eye_key": "%item.fermented_spider_eye.name",
          "#is_turtle_shell_key": "%item.turtle_helmet.name",
          "#is_water_bottle_key": "%potion.emptyPotion.name",
          "#is_slime_block_key": "%tile.slime.name",
          "#is_stone_key": "%tile.stone.stone.name",
          "#is_blaze_powder_key": "%item.blaze_powder.name",
          "#is_breeze_rod_key": "%item.breeze_rod.name",
          "#is_ghast_tear_key": "%item.ghast_tear.name",
          "#is_phantom_membrane_key": "%item.phantom_membrane.name",
          "#is_spider_eye_key": "%item.spider_eye.name",
          "#is_sugar_key": "%item.sugar.name",
          "#is_nether_wart_key": "%item.nether_wart.name",
          "#is_golden_carrot_key": "%item.golden_carrot.name",
          "#is_magma_cream_key": "%item.magma_cream.name",
          "#is_glistering_melon_key": "%item.speckled_melon.name",
          "#is_pufferfish_key": "%item.pufferfish.name",
          "#is_rabbit_foot_key": "%item.rabbit_foot.name",
          "#is_cobweb_key": "%tile.web.name",
          "#is_gunpowder_key": "%item.gunpowder.name",
          "#is_dragons_breath_key": "%item.dragon_breath.name",

          //modifier ingredients
          "#is_redstone_key": "%item.redstone.name",
          "#is_glowstone_key": "%item.glowstone_dust.name"
        }
      },
      {
        "requires": "($base_id = $brewing_guide:lingering_potion)",
        "$property_bag_for_children": {
          "#is_awkward_potion_key": "%potion.awkward.linger.name",
          "#is_night_vision_key": "%potion.nightVision.linger.name\n§7%potion.nightVision (0:45)",
          "#is_invisibility_key": "%potion.invisibility.linger.name\n§7%potion.invisibility (0:45)",
          "#is_leaping_key": "%potion.jump.linger.name\n§7%potion.jump (0:45)",
          "#is_fire_resistance_key": "%potion.fireResistance.linger.name\n§7%potion.fireResistance (0:45)",
          "#is_swiftness_key": "%potion.moveSpeed.linger.name\n§7%potion.moveSpeed (0:45)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
