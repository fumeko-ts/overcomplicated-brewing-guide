{
  "namespace": "brewing_global",
  "item_renderer@global.custom_renderer": {
    "$type": "inventory_item_renderer",
    "size": [16, 16],
    "anchor_from": "center",
    "anchor_to": "center",
    "property_bag": {
      "#item_id_aux": "(($base_id * 65536) + $remainder)"
    }
  },

  "container_item_slot_overlay@toggle.radio_toggle": {
    "size": [18, 18],
    "$toggle_group_forced_index": -1,
    "$toggle_name": "brewing_items",
    "$toggle_control_name": "brewing_reset",
    "$toggle_binding_value": "#item_brewing_reset",

    "$controls": [
      {
        "white_overlay@global.empty_image": {
          "size": [18, 18],
          "anchor_from": "center",
          "anchor_to": "center",
          "nineslice_size": 2,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png",
          "layer": 12,
          "alpha": 0.1915
        }
      },
      {
        "uncraftable_slot@global.empty_image": {
          "size": ["100%", "100%"],
          "nineslice_size": 2,
          "color": [0.996, 0.0, 0.008],
          "alpha": 0.19,
          "layer": 5,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png"
        }
      },
      {
        "hover_text_element@brewing_global.custom_hover_text_renderer": {
          "size": [18, 18]
        }
      },
      {
        "renderer@brewing_global.item_renderer": {
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 6
        }
      }
    ]
  },

  // factory is done like this to make it so i can re-use it without redeclairing, a new factory
  "factory@brewing_global.text_keys": {
    "size": [18, 18],

    "$remainder|default": 0,
    "$base_id|default": 0,

    "$factory_name|default": "Minecraft", // set collection name so i can use #collection_index on the elements that use this with the same collection name(it can be almost eanything even !!LEMON!!)

    "$awkward_potion_action|default": "",
    "$night_vision_action|default": "",
    "$invisibility_action|default": "",
    "$leaping_action|default": "",
    "$fire_resistance_action|default": "",
    "$swiftness_action|default": "",
    "$slowness_action|default": "",
    "$water_breathing_action|default": "",
    "$healing_action|default": "",
    "$harming_action|default": "",
    "$poison_action|default": "",
    "$regeneration_action|default": "",
    "$strength_action|default": "",
    "$weakness_action|default": "",
    "$turtle_master_action|default": "",
    "$slow_falling_action|default": "",
    "$wind_charging_action|default": "",
    "$weaving_action|default": "",
    "$oozing_action|default": "",
    "$infestation_action|default": "",

    "$factory_control_identifiers|default": {
      "is_awkward_potion": "$awkward_potion_action",
      "is_night_vision": "$night_vision_action",
      "is_invisibility": "$invisibility_action",
      "is_leaping": "$leaping_action",
      "is_fire_resistance": "$fire_resistance_action",
      "is_swiftness": "$swiftness_action",
      "is_slowness": "$slowness_action",
      "is_water_breathing": "$water_breathing_action",
      "is_healing": "$healing_action",
      "is_harming": "$harming_action",
      "is_poison": "$poison_action",
      "is_regeneration": "$regeneration_action",
      "is_strength": "$strength_action",
      "is_weakness": "$weakness_action",
      "is_turtle_master": "$turtle_master_action",
      "is_slow_falling": "$slow_falling_action",
      "is_wind_charging": "$wind_charging_action",
      "is_weaving": "$weaving_action",
      "is_oozing": "$oozing_action",
      "is_infestation": "$infestation_action"
    },

    "$factory_binding_values|default": {
      "#item_index_1": ["is_awkward_potion"],
      "#item_index_2": ["is_night_vision"],
      "#item_index_3": ["is_invisibility"],
      "#item_index_4": ["is_leaping"],
      "#item_index_5": ["is_fire_resistance"],
      "#item_index_6": ["is_swiftness"],
      "#item_index_7": ["is_slowness"],
      "#item_index_8": ["is_water_breathing"],
      "#item_index_9": ["is_healing"],
      "#item_index_10": ["is_harming"],
      "#item_index_11": ["is_poison"],
      "#item_index_12": ["is_regeneration"],
      "#item_index_13": ["is_strength"],
      "#item_index_14": ["is_weakness"],
      "#item_index_15": ["is_turtle_master"],
      "#item_index_16": ["is_slow_falling"],
      "#item_index_17": ["is_wind_charging"],
      "#item_index_18": ["is_weaving"],
      "#item_index_19": ["is_oozing"],
      "#item_index_20": ["is_infestation"]
    },
    "$factory_binding_refrence|default": "factory_bindings.bindings", // used to customise whats input for the #collection_length (collection length accepts a array like this ["control_id_you_want_to_render"])

    "$brewing_factory_variables|default": [
      // passes static values from above to the the generated controls and inner parts
      "$awkward_potion_action",
      "$night_vision_action",
      "$invisibility_action",
      "$leaping_action",
      "$fire_resistance_action",
      "$swiftness_action",
      "$slowness_action",
      "$water_breathing_action",
      "$healing_action",
      "$harming_action",
      "$poison_action",
      "$regeneration_action",
      "$strength_action",
      "$weakness_action",
      "$turtle_master_action",
      "$slow_falling_action",
      "$wind_charging_action",
      "$weaving_action",
      "$oozing_action",
      "$infestation_action",
      "$base_id",
      "$remainder",
      "$item_collection",

      //translation keys
      "$awkward_potion_key",
      "$night_vision_key",
      "$invisibility_key",
      "$leaping_key",
      "$fire_resistance_key",
      "$swiftness_key",
      "$slowness_key",
      "$water_breathing_key",
      "$healing_key",
      "$harming_key",
      "$poison_key",
      "$regeneration_key",
      "$strength_key",
      "$weakness_key",
      "$the_turtle_master_key",
      "$slow_falling_key",
      "$wind_charging_key",
      "$weaving_key",
      "$oozing_key",
      "$infestation_key",

      //ingredient translation key passthrews
      "$fermented_spider_eye_key",
      "$turtle_shell_key",
      "$water_bottle_key",
      "$slime_block_key",
      "$stone_key",
      "$blaze_powder_key",
      "$breeze_rod_key",
      "$ghast_tear_key",
      "$phantom_membrane_key",
      "$spider_eye_key",
      "$sugar_key",
      "$nether_wart_key",
      "$golden_carrot_key",
      "$magma_cream_key",
      "$glistering_melon_key",
      "$pufferfish_key",
      "$rabbit_foot_key",
      "$cobweb_key",
      "$gunpowder_key",
      "$turtle_master_key",
      "$dragons_breath_key",

      //modifiers
      "$level",
      "$extended"
    ],

    "controls": [
      {
        "$factory_name@$factory_binding_refrence": {
          "type": "collection_panel",
          "size": [18, 18],
          "collection_name": "$factory_name", // same as the factory name for simplicity
          "factory": {
            "name": "$factory_name",
            "max_children_size": 1, // set to 1 because i only want 1 collection item for each control to render
            "control_ids": "$factory_control_identifiers", // actual controls that will be renderd
            "factory_variables": "$brewing_factory_variables"
          },
          "property_bag": "$factory_binding_values"
        }
      }
    ]
  },

  //the def that centralizes all localization keys
  "text_keys": {
    "type": "panel",
    //modifiers
    "$extended|default": false,
    "$level|default": 1,
    //default potion keys
    "$awkward_potion_key|default": "potion.awkward.name",
    "$night_vision_key|default": "%potion.nightVision.name\n§7%potion.nightVision (3:00)",
    "$invisibility_key|default": "%potion.invisibility.name\n§7%potion.invisibility (3:00)",
    "$leaping_key|default": "%potion.jump.name\n§7%potion.jump (3:00)",
    "$fire_resistance_key|default": "%potion.fireResistance.name\n§7%potion.fireResistance (3:00)",
    "$swiftness_key|default": "%potion.moveSpeed.name\n§7%potion.moveSpeed (3:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
    "$slowness_key|default": "%potion.moveSlowdown.name\n§c%potion.moveSlowdown (1:30)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
    "$water_breathing_key|default": "%potion.waterBreathing.name\n§7%potion.waterBreathing (3:00)",
    "$healing_key|default": "%potion.heal.name\n§7%potion.heal",
    "$harming_key|default": "%potion.harm.name\n§c%potion.harm",
    "$poison_key|default": "%potion.poison.name\n§c%potion.poison (0:45)",
    "$regeneration_key|default": "%potion.regeneration.name\n§7%potion.regeneration (0:45)",
    "$strength_key|default": "%potion.damageBoost.name\n§7%potion.damageBoost (3:00)\n\n§5%potion.effects.whenDrank\n§9+3 %potion.damageBoost",
    "$weakness_key|default": "%potion.weakness.name\n§c%potion.weakness (1:30)\n\n§5%potion.effects.whenDrank\n§c-4 %potion.damageBoost",
    "$the_turtle_master_key|default": "%potion.turtleMaster.name\n§c%potion.turtleMaster (0:20)\n§7%potion.turtleMaster2 (0:20)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
    "$slow_falling_key|default": "%potion.slowFalling.name\n§7%potion.slowFalling (1:30)",
    "$wind_charging_key|default": "%potion.windCharged.name\n§c%potion.windCharged (3:00)",
    "$weaving_key|default": "%potion.weaving.name\n§c%potion.weaving (3:00)",
    "$oozing_key|default": "%potion.oozing.name\n§c%potion.oozing (3:00)",
    "$infestation_key|default": "%potion.infested.name\n§c%potion.infested (3:00)",

    //ingredient translation keys
    "$fermented_spider_eye_key|default": "%item.fermented_spider_eye.name",
    "$turtle_shell_key|default": "%item.turtle_helmet.name",
    "$water_bottle_key|default": "%potion.emptyPotion.name",
    "$slime_block_key|default": "%tile.slime.name",
    "$stone_key|default": "%tile.stone.stone.name",
    "$blaze_powder_key|default": "%item.blaze_powder.name",
    "$breeze_rod_key|default": "%item.breeze_rod.name",
    "$ghast_tear_key|default": "%item.ghast_tear.name",
    "$phantom_membrane_key|default": "%item.phantom_membrane.name",
    "$spider_eye_key|default": "%item.spider_eye.name",
    "$sugar_key|default": "%item.sugar.name",
    "$nether_wart_key|default": "%item.nether_wart.name",
    "$golden_carrot_key|default": "%item.golden_carrot.name",
    "$magma_cream_key|default": "%item.magma_cream.name",
    "$glistering_melon_key|default": "%item.speckled_melon.name",
    "$pufferfish_key|default": "%item.pufferfish.name",
    "$rabbit_foot_key|default": "%item.rabbit_foot.name",
    "$cobweb_key|default": "%tile.web.name",
    "$gunpowder_key|default": "%item.gunpowder.name",
    "$turtle_master_key|default": "%potion.turtleMaster.name",
    "$dragons_breath_key|default": "%item.dragon_breath.name",

    //potion variant changing keys
    "variables": [
      //splash
      {
        "requires": "($base_id = $brewing_guide:splash_potion)",
        "$awkward_potion_key|default": "%potion.awkward.splash.name",
        "$night_vision_key|default": "%potion.nightVision.splash.name\n§7%potion.nightVision (3:00)",
        "$invisibility_key|default": "%potion.invisibility.splash.name\n§7%potion.invisibility (3:00)",
        "$leaping_key|default": "%potion.jump.splash.name\n§7%potion.jump (3:00)",
        "$fire_resistance_key|default": "%potion.fireResistance.splash.name\n§7%potion.fireResistance (3:00)",
        "$swiftness_key|default": "%potion.moveSpeed.splash.name\n§7%potion.moveSpeed (3:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
        "$slowness_key|default": "%potion.moveSlowdown.splash.name\n§c%potion.moveSlowdown (1:30)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$water_breathing_key|default": "%potion.waterBreathing.splash.name\n§7%potion.waterBreathing (3:00)",
        "$healing_key|default": "%potion.heal.splash.name\n§7%potion.heal",
        "$harming_key|default": "%potion.harm.splash.name\n§c%potion.harm",
        "$poison_key|default": "%potion.poison.splash.name\n§c%potion.poison (0:45)",
        "$regeneration_key|default": "%potion.regeneration.splash.name\n§7%potion.regeneration (0:45)",
        "$strength_key|default": "%potion.damageBoost.splash.name\n§7%potion.damageBoost (3:00)\n\n§5%potion.effects.whenDrank\n§9+3 %potion.damageBoost",
        "$weakness_key|default": "%potion.weakness.splash.name\n§c%potion.weakness (1:30)\n\n§5%potion.effects.whenDrank\n§c-4 %potion.damageBoost",
        "$the_turtle_master_key|default": "%potion.turtleMaster.splash.name\n§c%potion.turtleMaster (0:20)\n§7%potion.turtleMaster2 (0:20)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$slow_falling_key|default": "%potion.slowFalling.splash.name\n§7%potion.slowFalling (1:30)",
        "$wind_charging_key|default": "%potion.windCharged.splash.name\n§c%potion.windCharged (3:00)",
        "$weaving_key|default": "%potion.weaving.splash.name\n§c%potion.weaving (3:00)",
        "$oozing_key|default": "%potion.oozing.splash.name\n§c%potion.oozing (3:00)",
        "$infestation_key|default": "%potion.infested.splash.name\n§c%potion.infested (3:00)"
      },
      //lingering
      {
        "requires": "($base_id = $brewing_guide:lingering_potion)",
        "$awkward_potion_key|default": "%potion.awkward.linger.name",
        "$night_vision_key|default": "%potion.nightVision.linger.name\n§7%potion.nightVision (0:45)",
        "$invisibility_key|default": "%potion.invisibility.linger.name\n§7%potion.invisibility (0:45)",
        "$leaping_key|default": "%potion.jump.linger.name\n§7%potion.jump (0:45)",
        "$fire_resistance_key|default": "%potion.fireResistance.linger.name\n§7%potion.fireResistance (0:45)",
        "$swiftness_key|default": "%potion.moveSpeed.linger.name\n§7%potion.moveSpeed (0:45)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
        "$slowness_key|default": "%potion.moveSlowdown.linger.name\n§c%potion.moveSlowdown (0:22)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$water_breathing_key|default": "%potion.waterBreathing.linger.name\n§7%potion.waterBreathing (0:45)",
        "$healing_key|default": "%potion.heal.linger.name\n§7%potion.heal",
        "$harming_key|default": "%potion.harm.linger.name\n§c%potion.harm",
        "$poison_key|default": "%potion.poison.linger.name\n§c%potion.poison (0:11)",
        "$regeneration_key|default": "%potion.regeneration.linger.name\n§7%potion.regeneration (0:11)",
        "$strength_key|default": "%potion.damageBoost.linger.name\n§7%potion.damageBoost (0:45)\n\n§5%potion.effects.whenDrank\n§9+3 %potion.damageBoost",
        "$weakness_key|default": "%potion.weakness.linger.name\n§c%potion.weakness (0:22)\n\n§5%potion.effects.whenDrank\n§c-4 %potion.damageBoost",
        "$the_turtle_master_key|default": "%potion.turtleMaster.linger.name\n§c%potion.turtleMaster (0:05)\n§7%potion.turtleMaster2 (0:05)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$slow_falling_key|default": "%potion.slowFalling.linger.name\n§7%potion.slowFalling (0:22)",
        "$wind_charging_key|default": "%potion.windCharged.linger.name\n§c%potion.windCharged (0:45)",
        "$weaving_key|default": "%potion.weaving.linger.name\n§c%potion.weaving (0:45)",
        "$oozing_key|default": "%potion.oozing.linger.name\n§c%potion.oozing (0:45)",
        "$infestation_key|default": "%potion.infested.linger.name\n§c%potion.infested (0:45)"
      },
      //extended (drinkable)
      {
        "requires": "$extended",
        "$awkward_potion_key|default": "%potion.awkward.name",
        "$night_vision_key|default": "%potion.nightVision.name\n§7%potion.nightVision (8:00)",
        "$invisibility_key|default": "%potion.invisibility.name\n§7%potion.invisibility (8:00)",
        "$leaping_key|default": "%potion.jump.name\n§7%potion.jump (8:00)",
        "$fire_resistance_key|default": "%potion.fireResistance.name\n§7%potion.fireResistance (8:00)",
        "$swiftness_key|default": "%potion.moveSpeed.name\n§7%potion.moveSpeed (8:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
        "$slowness_key|default": "%potion.moveSlowdown.name\n§c%potion.moveSlowdown (4:00)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$water_breathing_key|default": "%potion.waterBreathing.name\n§7%potion.waterBreathing (8:00)",
        "$healing_key|default": "%potion.heal.name\n§7%potion.heal",
        "$harming_key|default": "%potion.harm.name\n§c%potion.harm",
        "$poison_key|default": "%potion.poison.name\n§c%potion.poison (2:00)",
        "$regeneration_key|default": "%potion.regeneration.name\n§7%potion.regeneration (2:00)",
        "$strength_key|default": "%potion.damageBoost.name\n§7%potion.damageBoost (8:00)\n\n§5%potion.effects.whenDrank\n§9+3 %potion.damageBoost",
        "$weakness_key|default": "%potion.weakness.name\n§c%potion.weakness (4:00)\n\n§5%potion.effects.whenDrank\n§c-4 %potion.damageBoost",
        "$the_turtle_master_key|default": "%potion.turtleMaster.name\n§c%potion.turtleMaster (0:40)\n§7%potion.turtleMaster2 (0:40)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$slow_falling_key|default": "%potion.slowFalling.name\n§7%potion.slowFalling (4:00)",
        "$wind_charging_key|default": "%potion.windCharged.name\n§c%potion.windCharged (3:00)", // Extended has same duration as base
        "$weaving_key|default": "%potion.weaving.name\n§c%potion.weaving (3:00)",
        "$oozing_key|default": "%potion.oozing.name\n§c%potion.oozing (3:00)",
        "$infestation_key|default": "%potion.infested.name\n§c%potion.infested (3:00)"
      },
      //level 2 (drinkable)
      {
        "requires": "($level = 2)",
        "$awkward_potion_key|default": "%potion.awkward.name",
        "$night_vision_key|default": "%potion.nightVision.name",
        "$invisibility_key|default": "%potion.invisibility.name",
        "$leaping_key|default": "%potion.jump.name\n§7%potion.jump (1:30)",
        "$fire_resistance_key|default": "%potion.fireResistance.name",
        "$swiftness_key|default": "%potion.moveSpeed.name\n§7%potion.moveSpeed (1:30)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
        "$slowness_key|default": "%potion.moveSlowdown.name\n§c%potion.moveSlowdown (0:20)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$water_breathing_key|default": "%potion.waterBreathing.name",
        "$healing_key|default": "%potion.heal.name\n§7%potion.heal %potion.potency.1",
        "$harming_key|default": "%potion.harm.name\n§c%potion.harm %potion.potency.1",
        "$poison_key|default": "%potion.poison.name\n§c%potion.poison (0:22)",
        "$regeneration_key|default": "%potion.regeneration.name\n§7%potion.regeneration (0:22)",
        "$strength_key|default": "%potion.damageBoost.name\n§7%potion.damageBoost (1:30)\n\n§5%potion.effects.whenDrank\n§9+3 %potion.damageBoost",
        "$weakness_key|default": "%potion.weakness.name", //nolevel 2
        "$the_turtle_master_key|default": "%potion.turtleMaster.name\n§c%potion.turtleMaster (0:20)\n§7%potion.turtleMaster2 (0:20)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$slow_falling_key|default": "%potion.slowFalling.name",
        "$wind_charging_key|default": "%potion.windCharged.name",
        "$weaving_key|default": "%potion.weaving.name",
        "$oozing_key|default": "%potion.oozing.name",
        "$infestation_key|default": "%potion.infested.name"
      },
      //splash and extended
      {
        "requires": "(($base_id = $brewing_guide:splash_potion) and $extended)",
        "$awkward_potion_key|default": "%potion.awkward.splash.name",
        "$night_vision_key|default": "%potion.nightVision.splash.name\n§7%potion.nightVision (8:00)",
        "$invisibility_key|default": "%potion.invisibility.splash.name\n§7%potion.invisibility (8:00)",
        "$leaping_key|default": "%potion.jump.splash.name\n§7%potion.jump (8:00)",
        "$fire_resistance_key|default": "%potion.fireResistance.splash.name\n§7%potion.fireResistance (8:00)",
        "$swiftness_key|default": "%potion.moveSpeed.splash.name\n§7%potion.moveSpeed (8:00)\n\n§5%potion.effects.whenDrank\n§9+20%% %potion.moveSpeed",
        "$slowness_key|default": "%potion.moveSlowdown.splash.name\n§c%potion.moveSlowdown (4:00)\n\n§5%potion.effects.whenDrank\n§c-15%% %potion.moveSpeed",
        "$water_breathing_key|default": "%potion.waterBreathing.splash.name\n§7%potion.waterBreathing (8:00)",
        "$healing_key|default": "%potion.heal.splash.name\n§7%potion.heal",
