{
  "namespace": "brewing_toggle",
  /*
    changed how toggles inside this pack are done because the old way was hard to extend cleantly and minimaly
  */
  "secondary_toggle_properties": {},
  "secondary_toggle@brewing_global.empty_panel": {
    "$toggle_click_sound_volume|default": 1,
    "$toggle_collection_name|default": "<collection_group_name>",
    "$secondary_toggle_control_name|default": "<control_name>",
    
    "$secondary_toggle_mapping_type|default": "pressed",

    "$secondary_toggle_binding_value|default": "#toggle_state",
    "$secondary_toggle_starts_active|default": false,
    "$secondary_toggle_default_checked_index|default": 0,
    "$secondary_toggle_forced_index|default": -1,

    "$secondary_toggle_extra_properties|default": "brewing_toggle.secondary_toggle_properties",
    "$secondary_toggle_bindings|default": [
      { "binding_type": "collection_details" },
      {
        "binding_type": "global",
        "binding_condition": "always_when_visible",
        "binding_name": "$secondary_toggle_binding_value",
        "binding_name_override": "#toggle_state"
      }
    ],

    "controls": [
      {
        "$secondary_toggle_control_name@$secondary_toggle_extra_properties": {
          "type": "toggle",
          "size": ["100%", "100%"],
          "property_bag": {
            "#toggle_state": true
          },
          "button_mappings": [
            {"from_button_id":"button.menu_select"                 ,"to_button_id":"button.menu_ok","mapping_type":"$secondary_toggle_mapping_type"},
            {"from_button_id":"button.menu_secondary_select"       ,"to_button_id":"button.menu_ok","mapping_type":"$secondary_toggle_mapping_type"},
            {"from_button_id":"button.menu_ok"                     ,"to_button_id":"button.menu_ok","mapping_type":"$secondary_toggle_mapping_type"},
            {"from_button_id":"button.controller_select"           ,"to_button_id":"button.menu_ok","mapping_type":"$secondary_toggle_mapping_type"},
            {"from_button_id":"button.controller_secondary_select" ,"to_button_id":"button.menu_ok","mapping_type":"$secondary_toggle_mapping_type"}
          ],
          "sound_name": "random.click",
          "sound_volume": "$toggle_click_sound_volume",
          "sound_pitch": 1.0,

          "toggle_group_forced_index": "$secondary_toggle_forced_index",
          "toggle_group_default_selected": "$secondary_toggle_default_checked_index",
          "toggle_default_state": "$secondary_toggle_starts_active",
          
          "radio_toggle_group": true,

          "toggle_name": "$toggle_collection_name",
          "bindings": "$secondary_toggle_bindings",
          "focus_enabled": "$game_pad",
          "reset_on_focus_lost": true,
          "focus_wrap_enabled": false,
          "focus_magnet_enabled": false,
          "default_focus_precedence": 1
        }
      }
    ]
  },

  "toggle_properties": {},
  "toggle@brewing_global.empty_panel": {
    "$toggle_click_sound_volume|default": 1,
    "$toggle_collection_name|default": "<collection_group_name>",
    "$toggle_control_name|default": "<control_name>",
    
    "$toggle_mapping_type|default": "pressed",

    "$toggle_binding_value|default": "#toggle_state",
    "$toggle_starts_active|default": false,
    "$toggle_default_checked_index|default": 0,
    "$toggle_forced_index|default": -1,

    "$toggle_extra_properties|default": "brewing_toggle.toggle_properties",
    "$toggle_bindings|default": [
      { "binding_type": "collection_details" },
      {
        "binding_type": "global",
        "binding_condition": "always_when_visible",
        "binding_name": "$toggle_binding_value",
        "binding_name_override": "#toggle_state"
      }
    ],
    "controls": [
      {
        "$toggle_control_name@$toggle_extra_properties": {
          "type": "toggle",
          "size": ["100%", "100%"],
          "property_bag": {
            "#toggle_state": true
          },
          "button_mappings": [
            {"from_button_id":"button.menu_select"                 ,"to_button_id":"button.menu_ok","mapping_type":"$toggle_mapping_type"},
            {"from_button_id":"button.menu_secondary_select"       ,"to_button_id":"button.menu_ok","mapping_type":"$toggle_mapping_type"},
            {"from_button_id":"button.menu_ok"                     ,"to_button_id":"button.menu_ok","mapping_type":"$toggle_mapping_type"},
            {"from_button_id":"button.controller_select"           ,"to_button_id":"button.menu_ok","mapping_type":"$toggle_mapping_type"},
            {"from_button_id":"button.controller_secondary_select" ,"to_button_id":"button.menu_ok","mapping_type":"$toggle_mapping_type"}
          ],
          "sound_name": "random.click",
          "sound_volume": "$toggle_click_sound_volume",
          "sound_pitch": 1.0,
          "toggle_name": "$toggle_collection_name",
          "bindings": "$toggle_bindings",

          "toggle_group_forced_index": "$toggle_forced_index",
          "toggle_group_default_selected": "$toggle_default_checked_index",
          "toggle_default_state": "$toggle_starts_active",

          "radio_toggle_group": true,

          "focus_enabled": "$game_pad",
          "reset_on_focus_lost": true,
          "focus_wrap_enabled": false,
          "focus_magnet_enabled": false,
          "default_focus_precedence": 1
        }
      }
    ]
  },

  //region tabs

  "tab_toggle@brewing_toggle.toggle": {
    "size": "$tab_toggle_size",
    "$toggle_collection_name": "recipe_book_tab_toggles",

    "$toggle_starts_active": false,
    "$toggle_default_checked_index": 0,
    "$toggle_forced_index": 0,

    "$tab_toggle_size": [35, 27],

    "$toggle_extra_properties": "brewing_toggle.java_tab_toggle_properties",
    "variables": [
      {
        "requires": "($tab_toggle_type = 'bedrock')",
        "$toggle_extra_properties": "brewing_toggle.bedrock_tab_toggle_properties",
        "$tab_toggle_size": [25, 27]
      }
    ]
  },
  "bedrock_tab_toggle_properties": {
    "$extra_contents|default": "brewing_global.empty_panel",
    "unchecked_control": "unchecked",
    "checked_control": "checked",
    "unchecked_hover_control": "unchecked_hover",
    "checked_hover_control": "checked_hover",

    "$tab_checked_texture|default": "$bedrock_checked_default_image",
    "$tab_unchecked_texture|default": "$bedrock_unchecked_default_image",
    "$tab_checked_hover_texture|default": "$bedrock_checked_hover_image",
    "$tab_unchecked_hover_texture|default": "$bedrock_unchecked_hover_image",

    "variables": {
      "requires": "$toggle_starts_active",
      "$tab_checked_texture": "$bedrock_checked_default_image_left",
      "$tab_unchecked_texture": "$bedrock_unchecked_default_image_left",
      "$tab_checked_hover_texture": "$bedrock_checked_hover_image_left",
      "$tab_unchecked_hover_texture": "$bedrock_unchecked_hover_image_left"
    },

    "controls": [
      {"checked@brewing_global.empty_image": {"texture":"$tab_checked_texture","layer": 3}},
      {"unchecked@brewing_global.empty_image": {"texture":"$tab_unchecked_texture","layer": 0}},
      {"checked_hover@brewing_global.empty_image": {"texture":"$tab_checked_hover_texture","layer": 3}},
      {"unchecked_hover@brewing_global.empty_image": {"texture":"$tab_unchecked_hover_texture","layer": 0}},
      {"$extra_contents@$extra_contents": {}}
    ]
  },
  "java_tab_toggle_properties": {
    "$extra_contents|default": "brewing_global.empty_panel",
    "unchecked_hover_control": "unchecked",
    "checked_hover_control": "checked",
    "unchecked_control": "unchecked",
    "checked_control": "checked",
    "controls": [
      {"checked@brewing_global.empty_image": {"offset": [3, 0],"texture":"$java_checked_default_image","layer": 3}},
      {"unchecked@brewing_global.empty_image": {"offset": [5, 0],"texture":"$java_unchecked_default_image","layer": 0}},
      {
        "$extra_contents@$extra_contents": {
          "offset": "#offset",
          "property_bag": {
            "#icon_offset_false": [0, 0],
            "#icon_offset_true": [-2, 0]
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$toggle_control_name",
              "source_property_name": "#toggle_state",
              "target_property_name": "#tab_selected"
            },
            {
              "binding_type": "view",
              "source_property_name": "('#icon_offset_' + #tab_selected)",
              "target_property_name": "#offset"
            }
          ]
        }
      }
    ]
  },

  "layout_toggle@brewing_toggle.toggle": {
    "size": "$layout_size",
    "$toggle_extra_properties": "brewing_toggle.layout_toggle_properties",
    "$toggle_collection_name": "layout_toggle"
  },
  "recipe_layout_toggle@brewing_global.empty_panel": {
    "$layout_size": [20, 18],
    "$recipe_book_open_control_name|default": "brewing_guide_toggle_1",
    "$recipe_book_close_control_name|default": "brewing_guide_toggle_2",
    "$hover_layout_texture|default": "assets/brewing_guide/sprites/recipe_book/button_highlighted",
    "$default_layout_texture|default": "assets/brewing_guide/sprites/recipe_book/button",
    "size": "$layout_size",
    "layer": 10,
    "controls": [
      {
        "recipe_book_layout_toggle@brewing_toggle.layout_toggle": {
          "$toggle_forced_index": 0,
          "$toggle_binding_value": "('#' + $recipe_book_open_control_name)",
          "$toggle_control_name": "$recipe_book_open_control_name",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$toggle_control_name",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "inventory_toggle@brewing_toggle.layout_toggle": {
          "$toggle_forced_index": 1,
          "$toggle_binding_value": "('#' + $recipe_book_close_control_name)",
          "$toggle_control_name": "$recipe_book_close_control_name",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$recipe_book_open_control_name",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "layout_toggle_properties": {
    "unchecked_control": "unchecked",
    "checked_control": "checked",
    "unchecked_hover_control": "unchecked_hover",
    "checked_hover_control": "checked_hover",
    "controls": [
      {"checked@brewing_global.empty_image": {"texture":"$default_layout_texture"}},
      {"unchecked@brewing_global.empty_image": {"texture":"$default_layout_texture"}},
      {"checked_hover@brewing_global.empty_image": {"texture":"$hover_layout_texture"}},
      {"unchecked_hover@brewing_global.empty_image": {"texture":"$hover_layout_texture"}}
    ]
  }
}