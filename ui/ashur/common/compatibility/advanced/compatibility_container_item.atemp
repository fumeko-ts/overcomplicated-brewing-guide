{
  "namespace": "compatibility_container_item",

  "container_item_bridge@global.empty_panel": {
    "$custom_slot_content|default": "global.empty_panel",
    "$base_id|default": "$brewing_guide:potion",
    "variables": [
      {
        "requires": "($item_collection = 'brewing_input_item')", //ingredient item slot
        "$custom_slot_content": "compatibility_container_item.brewing_ingredient_item_slot"
      },
      {
        "requires": "($item_collection = 'brewing_result_items')", //potion bottle slots
        "$custom_slot_content": "compatibility_container_item.brewing_result_item_slot"
      }
    ]
  },
  "brewing_result_item_slot": {
    "type": "panel",
    "controls": [
      { "potion@brewing_potion_slot.potion_factory": {} },
      { "splash_potion@brewing_potion_slot.splash_potion_factory": {} },
      { "lingering_potion@brewing_potion_slot.lingering_potion_factory": {} }
    ]
  },
  "brewing_ingredient_item_slot": {
    "type": "panel",
    "controls": [
      { "potion_ingredients@brewing_potion_slot.potion_ingredient_factory": {} },
      { "splash_potion_ingredients@brewing_potion_slot.splash_potion_ingredient_factory": {} },
      { "lingering_potion_ingredients@brewing_potion_slot.lingering_potion_ingredient_factory": {} }
    ]
  }
}
