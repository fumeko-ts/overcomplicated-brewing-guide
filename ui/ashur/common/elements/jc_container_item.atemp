{
  "namespace": "jc_container_item",
  "container_item@compatibility_container_item.container_item_bridge": {
    "$cell_hover_text_bindings|default": [
      {
        "binding_type": "collection",
        "binding_collection_name": "$item_collection",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "$item_collection",
        "binding_name": "#hover_text",
        "binding_name_override": "#hover_text_binding"
      },
      {
        "binding_name": "#show_bundle_tooltip_hover"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(#hover_text_binding + '\n\nitem id: ' + (#item_id_aux / 65536))",
        "target_property_name": "#hover_text"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "((not ((#hover_text_binding = '') and #show_bundle_tooltip_hover)))",
        "target_property_name": "#visible"
      }
    ]
  }
}
